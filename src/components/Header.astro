---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isQuotePage = pathname === '/quote';

// Pages that have a LIGHT / WHITE background at the top:
const isLightPage = [
  '/portfolio',
  '/design-system',
  '/blog',
].includes(pathname) || pathname.startsWith('/blog/') || pathname.startsWith('/portfolio/');

const isLightHeader = isLightPage && !isQuotePage;
---

<header 
  id="main-header" 
  class="absolute top-0 left-0 right-0 z-[100] w-full px-6 sm:px-12 py-6 font-elegant bg-transparent"
>
  <div class="w-full max-w-7xl mx-auto flex items-center justify-between">
    
    <!-- Left: Avatar Photo Logo -->
    <a href="/" aria-label="Yasir Jamal" class="flex items-center group relative z-10">
      <div class="w-11 h-11 rounded-full bg-[#F6CD0B] p-0.5 flex items-center justify-center overflow-hidden shadow-lg group-hover:scale-105 transition-transform">
        <img src="/images/logo.webp" alt="Yasir Jamal" width="44" height="44" loading="eager" decoding="async" class="w-full h-full object-cover rounded-full" />
      </div>
    </a>

    <!-- Center: Clean Navigation Links -->
    {!isQuotePage ? (
      <nav class={`hidden md:flex items-center gap-10 text-sm md:text-base font-medium relative z-10 ${isLightHeader ? 'text-slate-900' : 'text-white/90'}`}>
        <a href="/#services" class={isLightHeader ? "hover:text-[#1559E7] transition-colors" : "hover:text-white transition-colors"}>Services</a>
        <a href="/portfolio/" class={isLightHeader ? "hover:text-[#1559E7] transition-colors" : "hover:text-white transition-colors"}>Case Studies</a>
        <a href="/blog/" class={isLightHeader ? "hover:text-[#1559E7] transition-colors" : "hover:text-white transition-colors"}>Blog</a>
        <a href="/about/" class={isLightHeader ? "hover:text-[#1559E7] transition-colors" : "hover:text-white transition-colors"}>About</a>
      </nav>
    ) : (
      <span class="text-slate-700 text-xs font-medium tracking-wide hidden md:inline">
        ⚡ High-Priority Quote Request
      </span>
    )}

    <!-- Right: Minimalist Action CTA -->
    <div class="flex items-center gap-2 sm:gap-3 relative z-10">
      {!isQuotePage ? (
        <a 
          href="https://wa.me/971552600494" 
          target="_blank" 
          rel="noopener noreferrer" 
          class={isLightHeader 
            ? "bg-slate-950 text-white px-5 sm:px-7 py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-semibold hover:bg-slate-800 hover:scale-105 transition-all shadow-md whitespace-nowrap flex items-center gap-2 border border-slate-900" 
            : "bg-white text-[#01013E] px-5 sm:px-7 py-2.5 sm:py-3 rounded-full text-xs sm:text-sm font-semibold hover:bg-slate-100 hover:scale-105 transition-all shadow-lg whitespace-nowrap flex items-center gap-2 border border-white/20"}
        >
          <span>Let's Talk</span>
          <span class="text-sm sm:text-base">&rarr;</span>
        </a>
      ) : (
        <a href="/" class="text-xs font-semibold text-slate-800 hover:text-slate-950 transition-colors bg-white px-4 py-2 rounded-full border border-slate-200 shadow-sm">
          &larr; Back to Main Site
        </a>
      )}
    </div>
  </div>
</header>
