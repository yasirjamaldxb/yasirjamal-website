---
const pathname = Astro.url.pathname;
const isQuotePage = pathname.replace(/\/$/, '') === '/quote';
---

<footer class={`w-full bg-slate-50 ${isQuotePage ? 'pt-8' : 'pt-20'} pb-12 font-elegant`}>
  
  <!-- Pre-Footer CTA Section (Hidden on /quote page) -->
  {!isQuotePage && (
    <div class="max-w-4xl mx-auto px-6 text-center mb-16 relative z-10">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-[#01013E] text-xs font-semibold uppercase tracking-wider mb-5 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#1559E7] animate-pulse"></span>
        Direct Senior Partnership
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-[#01013E] tracking-tight text-center mb-4">
        let&apos;s talk
      </h2>
      <p class="text-slate-600 font-light text-sm sm:text-base max-w-2xl mx-auto mb-9 leading-relaxed">
        Yasir Jamal is a Senior Product Designer and Freelance Web Designer based in Dubai, serving clients worldwide across the UAE, North America, Europe and Australia. Specializing in Product Design, UX/UI Design, Website Design, SEO, Conversion Optimization and Digital Strategy.
      </p>

      <div class="flex items-center justify-center">
        <a 
          href="https://wa.me/971552600494" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-3 bg-[#1559E7] text-white px-9 py-4 rounded-full text-sm font-semibold hover:bg-[#01013E] transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-1"
        >
          <span>Talk to consultant</span>
          <span class="text-base">&rsaquo;</span>
        </a>
      </div>
    </div>
  )}

  <!-- Main Unified Dark Footer Card Container -->
  <div class="w-full px-4 sm:px-6 md:px-8">
    <div class="w-full bg-[#01013E] rounded-[2.5rem] p-6 sm:p-10 text-white relative shadow-2xl overflow-hidden border border-slate-800">
      
      {!isQuotePage && (
        <>
          <!-- 4-Column Clean SEO Silo Structure -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-16 font-elegant text-xs">
            
            <!-- Column 1: Core Services Silo -->
            <div>
              <span class="text-xs font-semibold text-[#F6CD0B] uppercase tracking-wider block mb-4">
                Services Silo
              </span>
              <ul class="space-y-2.5 text-[#B7D5DF]">
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design Dubai</a></li>
                <li><a href="/ecommerce-web-design-dubai" class="hover:text-white transition-colors">eCommerce Architecture</a></li>
                <li><a href="/mobile-app-development" class="hover:text-white transition-colors">Mobile App Engineering</a></li>
                <li><a href="/quote" class="hover:text-white transition-colors">UI/UX & Product Design</a></li>
                <li><a href="/quote" class="hover:text-white transition-colors">Full Stack Astro Development</a></li>
                <li><a href="/quote" class="hover:text-white transition-colors">Technical SEO Schema Audit</a></li>
              </ul>
            </div>

            <!-- Column 2: Dubai Locations Silo (SEO Advanced Silo) -->
            <div>
              <span class="text-xs font-semibold text-[#F6CD0B] uppercase tracking-wider block mb-4">
                Locations & GCC
              </span>
              <ul class="space-y-2.5 text-[#B7D5DF]">
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design Dubai Media City</a></li>
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design Business Bay</a></li>
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design Downtown Dubai</a></li>
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design Abu Dhabi</a></li>
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design Dubai Marina</a></li>
                <li><a href="/web-design-dubai" class="hover:text-white transition-colors">Web Design DIFC</a></li>
              </ul>
            </div>

            <!-- Column 3: Navigation & Authority -->
            <div>
              <span class="text-xs font-semibold text-[#F6CD0B] uppercase tracking-wider block mb-4">
                Navigation
              </span>
              <ul class="space-y-2.5 text-[#B7D5DF]">
                <li><a href="/blog" class="hover:text-white transition-colors font-semibold text-[#F6CD0B]">Blog & Knowledge Hub</a></li>
                <li><a href="/portfolio" class="hover:text-white transition-colors">Case Studies</a></li>
                <li><a href="/#comparison" class="hover:text-white transition-colors">Traditional vs Senior Engineering</a></li>
                <li><a href="/#process" class="hover:text-white transition-colors">6-Phase Methodology</a></li>
                <li><a href="/about" class="hover:text-white transition-colors">About Yasir Jamal (15+ Yrs)</a></li>
                <li><a href="/quote" class="hover:text-white transition-colors">Request Fixed Proposal</a></li>
              </ul>
            </div>

            <!-- Column 4: Dubai Studio & Compact Local SEO Map -->
            <div>
              <span class="text-xs font-semibold text-[#F6CD0B] uppercase tracking-wider block mb-4">
                Dubai Studio
              </span>
              <div class="space-y-2.5 text-[#B7D5DF]">
                <p>Ground Floor, Building 08,<br />Dubai Media City, UAE</p>
                <p class="pt-0.5">
                  <a href="tel:+971552600494" class="text-white font-medium hover:underline">+971 55 2600 494</a>
                </p>
                <p>
                  <a href="mailto:info@yasirjamal.com" class="hover:text-white transition-colors">info@yasirjamal.com</a>
                </p>
              </div>
            </div>

          </div>

          <!-- Proof Metrics Bar -->
          <div class="pt-10 pb-8 mb-10 border-t border-b border-slate-800 grid grid-cols-1 md:grid-cols-4 gap-6 text-center font-elegant">
            <div class="flex flex-col items-center justify-center p-2">
              <span class="text-[#F6CD0B] text-xl font-bold tracking-tight block">150+ Websites</span>
              <span class="text-[#B7D5DF] text-xs font-light mt-1.5 block">Engineered Across Dubai & UAE</span>
            </div>

            <div class="flex flex-col items-center justify-center p-2 pt-4 md:pt-2">
              <span class="text-[#F6CD0B] text-xl font-bold tracking-tight block">15+ Years</span>
              <span class="text-[#B7D5DF] text-xs font-light mt-1.5 block">Senior Engineering Experience</span>
            </div>

            <div class="flex flex-col items-center justify-center p-2 pt-4 md:pt-2">
              <span class="text-[#F6CD0B] text-xl font-bold tracking-tight block">Sub-Second Speed</span>
              <span class="text-[#B7D5DF] text-xs font-light mt-1.5 block">Google Core Web Vitals Optimization</span>
            </div>

            <div class="flex flex-col items-center justify-center p-2 pt-4 md:pt-2">
              <span class="text-[#F6CD0B] text-xl font-bold tracking-tight block">100% Risk-Free</span>
              <span class="text-[#B7D5DF] text-xs font-light mt-1.5 block">Post-Launch Warranty & Support</span>
            </div>
          </div>
        </>
      )}

      <!-- Bottom Row: Copyright & Legal -->
      <div class="flex flex-col sm:flex-row justify-between items-center text-[11px] text-slate-400 gap-4">
        <p>&copy; {new Date().getFullYear()} Yasir Jamal. All rights reserved. Registered Web Design & SEO Consultant Dubai, UAE.</p>
        <div class="flex items-center gap-6">
          <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
          <a href="https://wa.me/971552600494" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp Support</a>
        </div>
      </div>

    </div>
  </div>
</footer>
