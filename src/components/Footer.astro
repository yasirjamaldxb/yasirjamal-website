---
const pathname = Astro.url.pathname;
const isHomePage = pathname === '/' || pathname === '';
---

<footer class="w-full bg-slate-50 pt-20 pb-12 font-elegant">
  
  <!-- Pre-Footer CTA Section -->
  <div class="max-w-4xl mx-auto px-6 text-center mb-16 relative z-10">
    {isHomePage ? (
      <>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-[#01013E] tracking-tight text-center mb-4">
          let&apos;s talk
        </h2>
        <p class="text-slate-600 font-light text-sm sm:text-base max-w-2xl mx-auto mb-9 leading-relaxed">
          Yasir Jamal is a Senior Product Designer and Freelance Web Designer based in Dubai, serving clients worldwide across the UAE, North America, Europe and Australia. Specializing in Product Design, UX/UI Design, Website Design, SEO, Conversion Optimization and Digital Strategy.
        </p>
      </>
    ) : (
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-[#01013E] tracking-tight text-center mb-8">
        Ready to elevate your digital presence?
      </h2>
    )}

    <div class="flex items-center justify-center">
      <a 
        href="https://wa.me/971552600494" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-3 bg-[#1559E7] text-white px-9 py-4 rounded-full text-sm font-semibold hover:bg-[#01013E] transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-1"
      >
        <span>Talk to consultant</span>
        <span class="text-base">&rsaquo;</span>
      </a>
    </div>
  </div>

  <!-- Main Unified Dark Footer Card Container -->
  <div class="w-full px-4 sm:px-6 md:px-8">
    <div class="w-full bg-[#01013E] rounded-[2.5rem] p-8 sm:p-12 md:p-16 text-white relative shadow-2xl overflow-hidden border border-slate-800">
      
      <!-- Top Grid: Mobbin Style Layout -->
      <div class="flex flex-col lg:flex-row justify-between items-start gap-12 lg:gap-16 mb-16 md:mb-20">
        
        <!-- Left Side: Brand & Subtitle -->
        <div class="max-w-md space-y-4">
          <a href="/" aria-label="Yasir Jamal" class="inline-block group">
            <div class="w-11 h-11 rounded-full bg-[#F6CD0B] p-0.5 flex items-center justify-center overflow-hidden shrink-0 shadow-lg group-hover:scale-105 transition-transform">
              <img src="/images/logo.webp" alt="Yasir Jamal" width="44" height="44" class="w-full h-full object-cover rounded-full" />
            </div>
          </a>
          <p class="text-slate-300 text-sm sm:text-base font-light leading-relaxed">
            Senior Product Designer &amp; Web Engineer based in Dubai Media City, designing better digital experiences for startups and enterprise brands worldwide.
          </p>
        </div>

        <!-- Right Side: Clean 2-Column Links (Mobbin Style Typography) -->
        <div class="grid grid-cols-2 gap-10 sm:gap-16 text-sm font-medium">
          
          <!-- Column 1: Navigation -->
          <div class="space-y-3.5 flex flex-col text-slate-200">
            <a href="/about/" class="hover:text-[#F6CD0B] transition-colors">About</a>
            <a href="/portfolio/" class="hover:text-[#F6CD0B] transition-colors">Case Studies</a>
            <a href="/calculator/" class="hover:text-[#F6CD0B] transition-colors">Cost Estimator</a>
            <a href="/blog/" class="hover:text-[#F6CD0B] transition-colors">Blog</a>
          </div>

          <!-- Column 2: Connect & Contact -->
          <div class="space-y-3.5 flex flex-col text-slate-200">
            <a href="https://wa.me/971552600494" target="_blank" rel="noopener noreferrer" class="hover:text-[#F6CD0B] transition-colors">Contact</a>
            <a href="https://wa.me/971552600494" target="_blank" rel="noopener noreferrer" class="hover:text-[#F6CD0B] transition-colors">WhatsApp</a>
            <a href="mailto:info@yasirjamal.com" class="hover:text-[#F6CD0B] transition-colors">info@yasirjamal.com</a>

            <!-- Separation Line & Social Icons -->
            <div class="pt-3 border-t border-slate-800/80 flex items-center gap-4">
              <!-- LinkedIn Icon -->
              <a 
                href="https://ae.linkedin.com/in/yasirjamal" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="LinkedIn"
                class="text-slate-300 hover:text-[#F6CD0B] transition-colors"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
              </a>

              <!-- Instagram Icon -->
              <a 
                href="https://www.instagram.com/withyasirjamal" 
                target="_blank" 
                rel="noopener noreferrer" 
                aria-label="Instagram"
                class="text-slate-300 hover:text-[#F6CD0B] transition-colors"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </div>

        </div>

      </div>

      <!-- Bottom Row: Copyright & Legal (Mobbin Style) -->
      <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4">
        <p>&copy; Yasir Jamal 2010to{new Date().getFullYear()}</p>
        <div class="flex items-center gap-6">
          <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy policy</a>
          <a href="/terms/" class="hover:text-white transition-colors">Terms</a>
        </div>
      </div>

    </div>
  </div>
</footer>
