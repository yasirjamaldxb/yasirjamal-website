---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "Web Design & UX Case Studies | Selected Works by Yasir Jamal";
const seoDescription = "Explore recent web design and development case studies by Yasir Jamal including Alston & Clayden, Alomaids, Westminster Properties, SkyLynx, Dubai Podiatrist, Noor Abu Dhabi, and Paws & Planes.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/portfolio";

const projects = [
  {
    title: "Alston & Clayden",
    slug: "alston-clayden",
    domain: "alstonclayden.com",
    category: "Real Estate & Legal Advisory",
    image: "/images/portfolio/alston_clayden.jpg",
    description: "Bespoke web platform and brand architecture engineered for Alston & Clayden luxury real estate and corporate advisory in Dubai."
  },
  {
    title: "Alomaids",
    slug: "alomaids",
    domain: "alomaids.com",
    category: "Home Services & Tech Booking",
    image: "/images/portfolio/alomaids.jpg",
    description: "High-converting online booking engine and mobile-optimized web application for Dubai's premier home cleaning and maintenance provider."
  },
  {
    title: "Westminster Properties",
    slug: "westminster-properties",
    domain: "westminsterproperties.ae",
    category: "Luxury Real Estate Portal",
    image: "/images/portfolio/westminster.jpg",
    description: "Exclusive real estate portal showcasing luxury Dubai residences, architectural penthouses, and high-yield investment properties."
  },
  {
    title: "SkyLynx Aviation",
    slug: "skylynx",
    domain: "skylynx.ae",
    category: "Private Aviation & Jet Charter",
    image: "/images/portfolio/skylynx.jpg",
    description: "Premium private aviation charter platform engineered with instant flight request tools and VIP client portals."
  },
  {
    title: "Dubai Podiatrist Clinic",
    slug: "dubai-podiatrist",
    domain: "dubaipodiatrist.com",
    category: "Medical & Healthcare Platform",
    image: "/images/portfolio/dubai_podiatrist.jpg",
    description: "Specialist medical practice portal featuring online patient appointment booking, doctor profiles, and healthcare SEO architecture."
  },
  {
    title: "Noor Abu Dhabi",
    slug: "noor-abu-dhabi",
    domain: "noorabudhabi.com",
    category: "Renewable Solar Energy",
    image: "/images/p_noor_v2.jpg",
    description: "Enterprise web presentation and digital platform for Noor Abu Dhabi solar project, highlighting renewable energy leadership in the UAE."
  },
  {
    title: "Paws & Planes UAE",
    slug: "paws-and-planes",
    domain: "pawsandplanes.ae",
    category: "Pet Relocation & Travel Portal",
    image: "/images/p_paws_v2.jpg",
    description: "MOCCAE-licensed pet relocation portal engineered with custom door-to-door flight calculators and high-converting WhatsApp channels."
  }
];
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
    <Schema title={seoTitle} description={seoDescription} url={pageUrl} type="LocalBusiness" />
  </Fragment>

  <main class="w-full bg-[#f8fafc] text-slate-900 pt-28 sm:pt-36 pb-28 font-elegant relative overflow-hidden min-h-screen">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
      
      <!-- Clean Minimalist Header (Exact Match to User Reference Screenshot) -->
      <div class="flex flex-col md:flex-row items-baseline md:items-center justify-between gap-6 mb-14 sm:mb-18">
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl text-[#01013E] font-normal tracking-tight leading-tight">
            Case Studies & Client Projects Worldwide
          </h1>
        </div>
        <div class="max-w-md md:text-right">
          <p class="text-slate-500 text-xs sm:text-sm font-light leading-relaxed">
            A showcase of high-impact case studies designed and engineered for businesses across Dubai, Abu Dhabi, and global markets.
          </p>
        </div>
      </div>

      <!-- Asymmetrical Editorial Staggered Grid (Tightly Spaced Meta Text Below Image) -->
      <div class="grid grid-cols-1 md:grid-cols-2 items-start gap-x-10 sm:gap-x-14 lg:gap-x-16 gap-y-12 sm:gap-y-16 mb-24">
        {projects.map((project, idx) => (
          <a 
            href={`/portfolio/${project.slug}/`} 
            class={`group flex flex-col block ${idx % 2 === 1 ? 'md:mt-20' : ''}`}
          >
            <!-- Image Frame -->
            <div class="relative w-full aspect-[4/3] rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-[0_10px_35px_rgba(0,0,0,0.04)] group-hover:shadow-[0_20px_50px_rgba(0,0,0,0.1)] transition-all duration-500">
              <img 
                src={project.image} 
                alt={project.title} 
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out" 
              />
            </div>

            <!-- Tight Meta Underneath (Tight pt-3.5 Spacing directly under image) -->
            <div class="flex justify-between items-start pt-3.5 sm:pt-4 gap-4">
              <div>
                <h2 class="text-xl sm:text-2xl font-semibold text-slate-900 leading-tight group-hover:text-[#1559E7] transition-colors">
                  {project.title}
                </h2>
              </div>
              <div class="text-right shrink-0">
                <span class="text-[10px] sm:text-xs font-bold text-slate-400 uppercase tracking-widest block">
                  {project.category}
                </span>
                <span class="text-[10px] font-semibold text-[#1559E7] uppercase tracking-wider block mt-0.5 group-hover:underline">
                  View Project &rarr;
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>
