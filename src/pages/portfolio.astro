---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "Web Design & UX Case Studies | Selected Works by Yasir Jamal";
const seoDescription = "Explore selected web design, UI/UX, and web development case studies by Yasir Jamal across healthcare, luxury fashion, real estate, logistics, and enterprise sectors in Dubai and worldwide.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/portfolio";

const projects = [
  {
    title: "Julphar Pharmaceuticals",
    slug: "julphar",
    domain: "julphar.net",
    category: "Pharmaceuticals & Healthcare",
    image: "/images/portfolio/showcase_julphar.jpg",
    description: "Enterprise regional web portal for Julphar Gulf Pharmaceutical Industries, one of the largest pharmaceutical manufacturers in the MENA region."
  },
  {
    title: "Abaya Dore",
    slug: "abayadore",
    domain: "abayadore.com",
    category: "Luxury Fashion & eCommerce",
    image: "/images/portfolio/showcase_abayadore.jpg",
    description: "Luxury abaya couture portal and high-converting boutique website engineered with instant checkout and mobile WhatsApp ordering."
  },
  {
    title: "Prime Middle East",
    slug: "prime-middle-east",
    domain: "primemiddle-east.com",
    category: "Industrial & Corporate Services",
    image: "/images/portfolio/showcase_prime-middle-east.jpg",
    description: "Enterprise corporate portal and industrial services web platform engineered for Prime Middle East across the GCC region."
  },
  {
    title: "Hunza Global",
    slug: "hunza-global",
    domain: "hunzaglobal.com",
    category: "Sustainable Environmental Engineering",
    image: "/images/portfolio/showcase_hunza-global.jpg",
    description: "Sustainable environmental engineering and clean water tech portal engineered for Hunza Global in Dubai, featuring 5 dedicated divisional hubs and commercial audit funnels."
  },
  {
    title: "Mark Williams",
    slug: "markwilliams",
    domain: "markwilliams.ae",
    category: "Executive Search & Recruitment",
    image: "/images/portfolio/showcase_markwilliams.jpg",
    description: "Senior executive search portal and high-impact recruitment web architecture engineered for Mark Williams in Dubai & Abu Dhabi."
  },
  {
    title: "FILA Tech Store",
    slug: "fila-tech",
    domain: "fila-tech.store",
    category: "eCommerce & Tech Retail",
    image: "/images/portfolio/showcase_fila-tech.jpg",
    description: "High-performance eCommerce store and digital technology catalog engineered with custom product filtering and instant checkout."
  },
  {
    title: "Alston & Clayden",
    slug: "alston-clayden",
    domain: "alstonclayden.com",
    category: "Real Estate & Legal Advisory",
    image: "/images/portfolio/showcase_alston-clayden.jpg",
    description: "Custom web platform and brand architecture engineered for Alston & Clayden luxury real estate and corporate advisory in Dubai."
  },
  {
    title: "Alomaids",
    slug: "alomaids",
    domain: "alomaids.com",
    category: "Home Services & Tech Booking",
    image: "/images/portfolio/showcase_alomaids.jpg",
    description: "High-converting online booking engine and mobile-optimized web application for Dubai's premier home cleaning and maintenance provider."
  },
  {
    title: "Westminster Properties",
    slug: "westminster-properties",
    domain: "westminsterproperties.ae",
    category: "Luxury Real Estate Portal",
    image: "/images/portfolio/showcase_westminster-properties.jpg",
    description: "Exclusive real estate portal showcasing luxury Dubai residences, architectural penthouses, and high-yield investment properties."
  },
  {
    title: "SkyLynx Aviation",
    slug: "skylynx",
    domain: "skylynx.ae",
    category: "Private Aviation & Jet Charter",
    image: "/images/portfolio/showcase_skylynx.jpg",
    description: "Premium private aviation charter platform engineered with instant flight request tools and VIP client portals."
  },
  {
    title: "Dubai Podiatrist Clinic",
    slug: "dubai-podiatrist",
    domain: "dubaipodiatrist.com",
    category: "Medical & Healthcare Platform",
    image: "/images/portfolio/showcase_dubai-podiatrist.jpg",
    description: "Specialist medical practice portal featuring online patient appointment booking, doctor profiles, and healthcare SEO architecture."
  },
  {
    title: "Noor Abu Dhabi",
    slug: "noor-abu-dhabi",
    domain: "noorabudhabi.ae",
    category: "Renewable Solar Energy",
    image: "/images/portfolio/showcase_noor-abu-dhabi.jpg",
    description: "Clean energy enterprise presentation and ESG sustainability platform engineered for Noor Abu Dhabi (1.17 GW), one of the world's largest solar plants."
  },
  {
    title: "Paws & Planes UAE",
    slug: "paws-and-planes",
    domain: "pawsandplanes.ae",
    category: "Pet Relocation & Travel Portal",
    image: "/images/portfolio/showcase_paws-and-planes.jpg",
    description: "MOCCAE-licensed pet relocation portal engineered with empathetic UI architecture, transparent travel guidance, and direct WhatsApp VIP consultation channels."
  },
  {
    title: "Baan Paa",
    slug: "baanpaa",
    domain: "baanpaa.com",
    category: "Landscape & Balcony Garden Design",
    image: "/images/portfolio/showcase_baanpaa.jpg",
    description: "Urban balcony landscape architecture, botanical design, and custom vertical garden installation web platform engineered for Baan Paa in Dubai."
  }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}/#collection`,
  "url": pageUrl,
  "name": seoTitle,
  "description": seoDescription,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": projects.length,
    "itemListElement": projects.map((p, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": p.title,
      "url": `${pageUrl}/${p.slug}/`,
      "description": p.description
    }))
  }
};
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
    <Schema title={seoTitle} description={seoDescription} url={pageUrl} type="LocalBusiness" />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <main class="w-full bg-[#f8fafc] text-slate-900 pt-28 sm:pt-36 pb-28 font-elegant relative overflow-hidden min-h-screen">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
      
      <!-- Clean Minimalist Header (Exact Match to User Reference Screenshot) -->
      <div class="flex flex-col md:flex-row items-baseline md:items-center justify-between gap-6 mb-14 sm:mb-18">
        <div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl text-[#01013E] font-normal tracking-tight leading-tight">
            Case Studies & Client Projects Worldwide
          </h1>
        </div>
        <div class="max-w-md md:text-right">
          <p class="text-slate-500 text-xs sm:text-sm font-light leading-relaxed">
            A showcase of high-impact case studies designed and engineered for businesses across Dubai, Abu Dhabi, and global markets.
          </p>
        </div>
      </div>

      <!-- Asymmetrical Editorial Staggered Grid (Tightly Spaced Meta Text Below Image) -->
      <div class="grid grid-cols-1 md:grid-cols-2 items-start gap-x-10 sm:gap-x-14 lg:gap-x-16 gap-y-12 sm:gap-y-16 mb-24">
        {projects.map((project, idx) => (
          <a 
            href={`/portfolio/${project.slug}/`} 
            class={`group flex flex-col block ${idx % 2 === 1 ? 'md:mt-20' : ''}`}
          >
            <!-- Image Frame -->
            <div class="relative w-full aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-[0_10px_35px_rgba(0,0,0,0.04)] group-hover:shadow-[0_20px_50px_rgba(0,0,0,0.1)] transition-all duration-500">
              <img 
                src={project.image} 
                alt={project.title} 
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out" 
              />
            </div>

            <!-- Tight Meta Underneath (Domain Removed as requested) -->
            <div class="flex justify-between items-baseline pt-3.5 sm:pt-4 gap-4">
              <div>
                <h2 class="text-xl sm:text-2xl font-normal text-[#01013E] tracking-tight leading-tight group-hover:text-[#1559E7] transition-colors">
                  {project.title}
                </h2>
              </div>
              <div class="text-right shrink-0">
                <span class="text-xs font-medium text-slate-400 uppercase tracking-wider block">
                  {project.category}
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>
