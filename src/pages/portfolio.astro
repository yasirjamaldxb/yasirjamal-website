---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "Web Design & UX Case Studies | Selected Works by Yasir Jamal";
const seoDescription = "Explore recent web design and development case studies by Yasir Jamal including Alston & Clayden, Alomaids, Westminster Properties, SkyLynx, Dubai Podiatrist, Noor Abu Dhabi, and Paws & Planes.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/portfolio";

const projects = [
  {
    title: "Alston & Clayden",
    slug: "alston-clayden",
    domain: "alstonclayden.com",
    category: "Real Estate & Legal Advisory",
    image: "/images/portfolio/alston_clayden.jpg",
    description: "Bespoke web platform and brand architecture engineered for Alston & Clayden luxury real estate and corporate advisory in Dubai."
  },
  {
    title: "Alomaids",
    slug: "alomaids",
    domain: "alomaids.com",
    category: "Home Services & Tech Booking",
    image: "/images/portfolio/alomaids.jpg",
    description: "High-converting online booking engine and mobile-optimized web application for Dubai's premier home cleaning and maintenance provider."
  },
  {
    title: "Westminster Properties",
    slug: "westminster-properties",
    domain: "westminsterproperties.ae",
    category: "Luxury Real Estate Portal",
    image: "/images/portfolio/westminster.jpg",
    description: "Exclusive real estate portal showcasing luxury Dubai residences, architectural penthouses, and high-yield investment properties."
  },
  {
    title: "SkyLynx Aviation",
    slug: "skylynx",
    domain: "skylynx.ae",
    category: "Private Aviation & Jet Charter",
    image: "/images/portfolio/skylynx.jpg",
    description: "Premium private aviation charter platform engineered with instant flight request tools and VIP client portals."
  },
  {
    title: "Dubai Podiatrist Clinic",
    slug: "dubai-podiatrist",
    domain: "dubaipodiatrist.com",
    category: "Medical & Healthcare Platform",
    image: "/images/portfolio/dubai_podiatrist.jpg",
    description: "Specialist medical practice portal featuring online patient appointment booking, doctor profiles, and healthcare SEO architecture."
  },
  {
    title: "Noor Abu Dhabi",
    slug: "noor-abu-dhabi",
    domain: "noorabudhabi.com",
    category: "Renewable Solar Energy",
    image: "/images/p_noor_v2.jpg",
    description: "Enterprise web presentation and digital platform for Noor Abu Dhabi solar project, highlighting renewable energy leadership in the UAE."
  },
  {
    title: "Paws & Planes UAE",
    slug: "paws-and-planes",
    domain: "pawsandplanes.ae",
    category: "Pet Relocation & Travel Portal",
    image: "/images/p_paws_v2.jpg",
    description: "MOCCAE-licensed pet relocation portal engineered with custom door-to-door flight calculators and high-converting WhatsApp channels."
  }
];
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
    <Schema title={seoTitle} description={seoDescription} url={pageUrl} type="LocalBusiness" />
  </Fragment>

  <main class="w-full bg-[#f8fafc] text-slate-900 pt-32 pb-24 font-elegant relative overflow-hidden min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Compact Minimalist Hero Headline -->
      <div class="text-center mb-14 sm:mb-16 max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 text-[#1559E7] text-xs font-semibold uppercase tracking-widest mb-4 border border-slate-200/80">
          Selected Case Studies
        </span>
        <h1 class="text-3xl sm:text-5xl text-[#01013E] font-light tracking-tight leading-snug mb-4">
          Case Studies & Client Projects
        </h1>
        <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed max-w-xl mx-auto">
          A showcase of high-impact case studies designed and engineered for businesses across Dubai, Abu Dhabi, and global markets.
        </p>
      </div>

      <!-- Single Lane Portfolio Showcase List (1 Work in 1 Lane) -->
      <div class="grid grid-cols-1 gap-12 sm:gap-16 mb-20 font-elegant">
        {projects.map((project, idx) => (
          <a href={`/portfolio/${project.slug}/`} class="group flex flex-col bg-white rounded-[2.5rem] overflow-hidden shadow-[0_15px_45px_rgba(0,0,0,0.06)] hover:shadow-[0_25px_60px_rgba(0,0,0,0.12)] hover:-translate-y-1 transition-all duration-500 border border-slate-200/80 block">
            
            <!-- Simulated Browser Header Bar -->
            <div class="bg-slate-100 px-6 py-3.5 border-b border-slate-200 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
              </div>
              <div class="px-5 py-1 rounded-full bg-white text-xs font-medium text-slate-500 border border-slate-200/80 shadow-inner">
                {project.domain}
              </div>
              <div class="text-xs font-bold text-slate-400">0{idx + 1}</div>
            </div>

            <!-- Full Width Image Showcase -->
            <div class="relative w-full aspect-[16/9] sm:aspect-[16/8] overflow-hidden bg-slate-100">
              <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out" />
            </div>

            <!-- Blue Accent Stripe -->
            <div class="h-1 bg-[#1559E7] w-full"></div>

            <!-- Card Content Area -->
            <div class="p-8 sm:p-10 flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-[#1559E7] tracking-widest mb-2.5 block uppercase">
                  {project.category}
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 leading-snug tracking-tight group-hover:text-[#1559E7] transition-colors mb-3">
                  {project.title}
                </h2>
                <p class="text-sm sm:text-base text-slate-600 font-light leading-relaxed mb-6">
                  {project.description}
                </p>
              </div>

              <!-- Bottom CTA Row -->
              <div class="flex items-center justify-between w-full pt-6 border-t border-slate-100">
                <span class="text-xs text-slate-500 font-medium">{project.domain}</span>
                <span class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-900 group-hover:text-[#1559E7] transition-colors">
                  <span>Explore Full Case Study</span>
                  <span class="text-base transition-transform group-hover:translate-x-1.5">&rarr;</span>
                </span>
              </div>
            </div>

          </a>
        ))}
      </div>

    </div>
  </main>
</Layout>
