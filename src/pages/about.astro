---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "About Yasir Jamal | Senior Product Designer & Web Design Consultant";
const seoDescription = "Learn about Yasir Jamal, a Senior Product Designer and Web Design Consultant with 15+ years of experience engineering high-converting, sub-second websites and digital products in Dubai and worldwide.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/about";
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
    <Schema title={seoTitle} description={seoDescription} url={pageUrl} type="LocalBusiness" />
  </Fragment>

  <main class="w-full bg-[#f8fafc] text-slate-900 font-elegant selection:bg-[#1559E7] selection:text-white overflow-x-hidden">

    <!-- 1. HERO SECTION: Dark Hero with Background Image & Gradient Overlays Matching Homepage -->
    <section class="relative w-full pt-28 pb-20 sm:pt-36 sm:pb-28 text-white overflow-hidden bg-[#01013E]">
      
      <!-- Background Image Matching Homepage -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/hero_v3.webp" 
          alt="Yasir Jamal - Senior Product Designer Background" 
          width="1200" 
          height="800" 
          loading="eager" 
          fetchpriority="high" 
          decoding="async" 
          class="w-full h-full object-cover object-[center_35%] opacity-30 mix-blend-overlay" 
        />
      </div>

      <!-- Ambient Gradient Overlays for optimal readability -->
      <div class="absolute inset-0 z-0 bg-gradient-to-r from-[#01013E] via-[#01013E]/90 to-[#01013E]/70"></div>
      <div class="absolute inset-0 z-0 bg-gradient-to-t from-[#f8fafc] via-transparent to-black/30"></div>

      <div class="max-w-7xl mx-auto px-6 sm:px-10 relative z-10">
        
        <!-- Eyebrow Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/15 text-[#F6CD0B] text-xs font-semibold uppercase tracking-wider mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#F6CD0B] animate-pulse"></span>
          <span>About Yasir Jamal</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Left Column: High-Impact Typography & Narrative -->
          <div class="lg:col-span-7">
            <h1 class="text-3xl sm:text-5xl md:text-6xl font-light text-white tracking-tight leading-[1.12] mb-6">
              Designing Digital Products <br class="hidden sm:inline" />
              <span class="font-normal italic text-[#F6CD0B]">That Help Businesses Grow</span>
            </h1>

            <p class="text-base sm:text-xl text-slate-200 font-light leading-relaxed mb-6 drop-shadow-sm">
              I'm <strong class="font-semibold text-white">Yasir Jamal</strong>, a Product Designer, UX/UI Designer, and Web Design Consultant with over 15 years of experience creating websites, SaaS platforms, digital products, and conversion-focused user experiences for businesses across the world.
            </p>

            <p class="text-sm sm:text-base text-slate-300 font-light leading-relaxed mb-8">
              I help startups, established companies, agencies, and enterprise organizations transform ideas into websites and digital products that are visually compelling, easy to use, technically scalable, and built to generate measurable business results.
            </p>

            <!-- Stat Cards Grid in Dark Theme Container -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/15">
              <div class="p-4 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md">
                <div class="text-2xl sm:text-3xl font-bold text-[#F6CD0B] tracking-tight">15+</div>
                <div class="text-[11px] font-medium text-slate-200 uppercase tracking-wider mt-1">Years Experience</div>
              </div>
              <div class="p-4 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md">
                <div class="text-2xl sm:text-3xl font-bold text-[#F6CD0B] tracking-tight">120+</div>
                <div class="text-[11px] font-medium text-slate-200 uppercase tracking-wider mt-1">Projects Built</div>
              </div>
              <div class="p-4 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md">
                <div class="text-2xl sm:text-3xl font-bold text-[#F6CD0B] tracking-tight">14+</div>
                <div class="text-[11px] font-medium text-slate-200 uppercase tracking-wider mt-1">Global Markets</div>
              </div>
              <div class="p-4 rounded-2xl bg-white/10 border border-white/15 backdrop-blur-md">
                <div class="text-2xl sm:text-3xl font-bold text-[#F6CD0B] tracking-tight">100<span class="text-xs text-white font-semibold">/100</span></div>
                <div class="text-[11px] font-medium text-slate-200 uppercase tracking-wider mt-1">Speed Standard</div>
              </div>
            </div>
          </div>

          <!-- Right Column: Clean Portrait Image Card with Glow -->
          <div class="lg:col-span-5 relative">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-white/10 p-3 border border-white/20 group">
              <img 
                src="/images/yasir_about.webp" 
                alt="Yasir Jamal - Senior Product Designer & Web Consultant" 
                width="600" 
                height="750" 
                loading="eager" 
                fetchpriority="high"
                class="w-full h-auto rounded-2xl object-cover" 
              />
              
              <!-- Floating Glassmorphic Badge -->
              <div class="absolute bottom-6 left-6 right-6 p-4 rounded-2xl bg-[#01013E]/90 backdrop-blur-md border border-white/20 shadow-xl">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full bg-[#25D366] animate-pulse"></div>
                  <div>
                    <div class="text-xs font-bold text-white uppercase tracking-wider">Product Designer & Consultant</div>
                    <div class="text-xs text-slate-300 font-light">Dubai Media City & Worldwide Remote</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. MISSION STATEMENT & CORE PHILOSOPHY BANNER -->
    <section class="py-16 sm:py-20 bg-white border-b border-slate-200/80">
      <div class="max-w-5xl mx-auto px-6 sm:px-10 text-center">
        <div class="p-8 sm:p-14 rounded-3xl bg-[#01013E] text-white shadow-[0_20px_50px_rgba(1,1,62,0.15)] relative overflow-hidden">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-64 h-64 bg-[#1559E7]/30 rounded-full blur-3xl pointer-events-none"></div>
          
          <span class="text-xs font-semibold uppercase tracking-widest text-[#F6CD0B] mb-4 block">
            My Mission
          </span>
          <h2 class="text-xl sm:text-3xl md:text-4xl font-light text-white leading-relaxed tracking-tight max-w-3xl mx-auto mb-6">
            "My mission is to help businesses around the world create digital products that users enjoy, search engines understand, and AI assistants confidently recommend."
          </h2>
          <p class="text-sm sm:text-base text-slate-300 font-light max-w-2xl mx-auto mb-8">
            Every website and product I design is built with a focus on usability, performance, accessibility, discoverability, and measurable business impact.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="https://wa.me/971552600494?text=Hi%20Yasir,%20I%20would%20like%20to%20schedule%20a%20Zoom%20or%20Google%20Meet%20video%20call%20to%20discuss%20my%20project." target="_blank" rel="noopener noreferrer" class="bg-[#25D366] text-slate-950 px-7 py-3.5 rounded-full text-xs sm:text-sm font-bold hover:bg-[#20ba5a] transition-all shadow-md inline-flex items-center gap-2">
              <svg class="w-4 h-4 fill-current text-slate-950" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.099 4.019 4.042-1.059z"/></svg>
              <span>Schedule a Video Call (Zoom / Google Meet)</span>
            </a>
            <a href="/quote" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-7 py-3.5 rounded-full text-xs sm:text-sm font-semibold transition-all">
              Request a Project Quote &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 1.5 BEHIND THE DESIGN: YASIR'S STORY, PHILOSOPHY & WORKING STYLE -->
    <section class="py-16 sm:py-24 bg-[#f8fafc] border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        
        <div class="max-w-3xl mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#1559E7] mb-3 block">
            Personal Story & Philosophy
          </span>
          <h2 class="text-2xl sm:text-4xl font-light text-[#01013E] tracking-tight leading-tight mb-4">
            Behind the Design: The Expert & The Philosophy
          </h2>
          <p class="text-slate-600 font-light text-base sm:text-lg">
            People hire people. Beyond technical frameworks and metrics, here is the story, principles, and personal working style that guide every digital product I build.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- Story & Start Card -->
          <div class="p-8 rounded-3xl bg-white shadow-[0_10px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#1559E7] text-white font-bold text-sm flex items-center justify-center mb-4">01</div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">My Story & Why I Started</h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed mb-4">
                Over 15 years ago, I began designing digital interfaces out of a deep fascination with how visual design directly shapes human decisions. What started as hands-on frontend engineering evolved into a senior product design consultancy serving founders and enterprise leaders across Dubai, the US, Europe, and the GCC.
              </p>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Having navigated the evolution from early web standards to modern AI-assisted web engineering, my journey has been defined by one constant: delivering digital experiences that perform for real businesses.
              </p>
            </div>
          </div>

          <!-- Philosophy Card -->
          <div class="p-8 rounded-3xl bg-white shadow-[0_10px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#1559E7] text-white font-bold text-sm flex items-center justify-center mb-4">02</div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">My Design Philosophy</h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed mb-4">
                Pretty design without business strategy is just decoration. I believe every layout choice, color palette, typography hierarchy, and call-to-action must serve a concrete business goal—whether that means boosting conversion rates, decreasing bounce rates, or guaranteeing sub-second load times.
              </p>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                I design digital products that respect the user's time, communicate value instantly, and make complex ideas effortlessly simple to understand.
              </p>
            </div>
          </div>

          <!-- What I've Learned Card -->
          <div class="p-8 rounded-3xl bg-white shadow-[0_10px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#1559E7] text-white font-bold text-sm flex items-center justify-center mb-4">03</div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">What 15+ Years Have Taught Me</h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed mb-4">
                Traditional agencies often charge massive overhead fees, assign account managers as middlemen, and delegate execution to junior developers after signing. 
              </p>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                I've learned that direct 1-on-1 collaboration between a founder and a senior expert produces vastly superior results. You get direct access to 15+ years of senior UX expertise on every single line of code and Figma frame.
              </p>
            </div>
          </div>

          <!-- How I Work & What I Care About -->
          <div class="p-8 rounded-3xl bg-white shadow-[0_10px_30px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-[#1559E7] text-white font-bold text-sm flex items-center justify-center mb-4">04</div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">How I Work & What I Care About</h3>
              <ul class="space-y-3 text-sm text-slate-600 font-light">
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold">✓</span>
                  <span><strong class="font-semibold text-slate-900">Direct Founder Communication:</strong> No telephone tag or middleman friction. We meet directly on 1-on-1 Zoom or Google Meet calls.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold">✓</span>
                  <span><strong class="font-semibold text-slate-900">Uncompromising Speed:</strong> Every site is optimized for 100/100 Google Lighthouse benchmarks and sub-500ms loads.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold">✓</span>
                  <span><strong class="font-semibold text-slate-900">AI-Engineered Efficiency:</strong> Harnessing ChatGPT, Claude, and Cursor to compress development timelines without sacrificing precision.</span>
                </li>
              </ul>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 2.5 INDEPENDENTLY VERIFIED REPUTATION & CERTIFICATIONS -->
    <section class="py-16 sm:py-24 bg-white border-b border-slate-200/80">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-[#1559E7] mb-2 block">
            Independent Third-Party Verification
          </span>
          <h2 class="text-2xl sm:text-4xl font-light text-[#01013E] tracking-tight">
            Independently Verified Credentials & Live Project Proof
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-light mt-2">
            Verified across Google Business Profile, LinkedIn, and live enterprise domain deployments.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          
          <!-- Card 1: Google Business Verified Rating -->
          <div class="p-8 rounded-3xl bg-[#f8fafc] shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-amber-500 text-lg font-bold">5.0 ★★★★★</span>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">(Google Verified)</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2">Google Business Profile</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mb-6">
                Independently verified 5-star client reviews and rating for Yasir Jamal Web Design Studio registered in Dubai Media City, UAE.
              </p>
            </div>
            <a href="https://www.google.com/maps/place/Freelance+Web+Designer+Dubai+%7C+Yasir+Jamal/@25.0948548,55.15958,17z/data=!3m2!4b1!5s0x3e5f6b42836d58e7:0x38fe9d6fdc42ed5b!4m6!3m5!1s0x3e5f6be497e53adf:0x66180c61e09efdce!8m2!3d25.0948548!4d55.1621603!16s%2Fg%2F11r_q1vgn1" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#1559E7] hover:text-[#01013E] underline underline-offset-4">
              <span>View Independent Google Reviews</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>

          <!-- Card 2: LinkedIn Recommendations & Certifications -->
          <div class="p-8 rounded-3xl bg-[#f8fafc] shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wider">LinkedIn Verified</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2">Professional Certifications</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mb-6">
                Third-party verified certifications, skill badges, and endorsement recommendations from international founders and agency leaders.
              </p>
            </div>
            <a href="https://ae.linkedin.com/in/yasirjamal" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#1559E7] hover:text-[#01013E] underline underline-offset-4">
              <span>Inspect LinkedIn Certifications & Recommendations</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>

          <!-- Card 3: Live Verified Website Implementations -->
          <div class="p-8 rounded-3xl bg-[#f8fafc] shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_45px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider">Live Deployments</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2">Live Client Web Application Proof</h3>
              <p class="text-xs text-slate-600 font-light leading-relaxed mb-6">
                Test and audit live client web applications engineered by Yasir Jamal across UAE & international markets for speed, UX, and performance.
              </p>
            </div>
            <a href="/portfolio/" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#1559E7] hover:text-[#01013E] underline underline-offset-4">
              <span>Explore Live Client Case Studies & Links</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
          </div>

        </div>

        <!-- Official Social & Design Networks Chips -->
        <div class="mt-10 pt-8 border-t border-slate-200/80">
          <div class="text-center mb-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#1559E7]">
              Verified Design & Social Profiles
            </span>
          </div>
          
          <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 max-w-4xl mx-auto">
            
            <!-- LinkedIn -->
            <a href="https://ae.linkedin.com/in/yasirjamal" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-2xl bg-[#f8fafc] border border-slate-200/90 hover:border-blue-500 hover:shadow-md transition-all flex items-center gap-2.5 group">
              <svg class="w-4 h-4 fill-[#0A66C2]" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
              <span class="text-xs font-bold text-slate-900 group-hover:text-blue-600">LinkedIn</span>
            </a>

            <!-- Behance -->
            <a href="https://www.behance.net/withyasirjamal" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-2xl bg-[#f8fafc] border border-slate-200/90 hover:border-[#1769FF] hover:shadow-md transition-all flex items-center gap-2.5 group">
              <svg class="w-4 h-4 fill-[#1769FF]" viewBox="0 0 24 24"><path d="M22 7h-7V5h7v2zm-1.7 8c0-2.2-1.4-3.5-3.6-3.5-2.4 0-3.9 1.6-3.9 3.8 0 2.4 1.5 3.9 4 3.9 1.9 0 3.2-.9 3.5-2.2h-1.9c-.2.5-.8.8-1.6.8-1.1 0-1.8-.6-1.9-1.6h5.4c0-.4 0-.8 0-1.2zm-5.4-.8c.1-.8.7-1.4 1.7-1.4.9 0 1.6.5 1.7 1.4h-3.4zM9.5 13c1.3 0 2.2-.6 2.2-1.7 0-.9-.6-1.4-1.5-1.5v-.1c.7-.2 1.2-.7 1.2-1.5 0-1.2-1-1.7-2.3-1.7H4v10h5.5zm-3.1-4.8h2.3c.6 0 1.1.2 1.1.8 0 .6-.5.8-1.1.8H6.4V8.2zm0 6.6v-2.1h2.5c.7 0 1.2.2 1.2.9 0 .7-.5.9-1.2.9H6.4z"/></svg>
              <span class="text-xs font-bold text-slate-900 group-hover:text-[#1769FF]">Behance</span>
            </a>

