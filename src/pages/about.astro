---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "About Yasir Jamal | Senior Product Designer & Web Design Consultant";
const seoDescription = "Learn about Yasir Jamal, a Senior Product Designer and Web Design Consultant with 15+ years of experience engineering high-converting, sub-second websites and digital products in Dubai and worldwide.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/about";

const aboutFaqs = [
  {
    q: "Why do clients choose to work with Yasir Jamal?",
    a: "Clients choose to work with me because I combine business strategy, user experience, visual design, SEO, and technical understanding into a single unified design process."
  },
  {
    q: "What are Yasir Jamal's core professional credentials and background?",
    a: "Yasir Jamal is a Senior Product Designer and Web Engineer based in Dubai Media City with over 15 years of continuous experience. Since 2010, he has delivered over 150 digital products, SaaS dashboards, and websites for clients across Dubai, Abu Dhabi, Saudi Arabia, Europe, and North America."
  },
  {
    q: "What third-party licenses and professional certifications does Yasir hold?",
    a: "Yasir holds verified credentials including Google Certified User Experience Specialist, HubSpot Growth-Driven Design Certification (ID: 73ce30bd3145), Coursera / Google A/B Testing & CRO, and Amplitude Product Analytics."
  },
  {
    q: "What is Yasir Jamal's specialized 6-phase design methodology?",
    a: "Yasir follows a systematic 6-phase approach: 1) Business & UX Discovery, 2) Strategy & Information Architecture, 3) Figma Wireframing & High-Fidelity UI Design, 4) Custom Sub-Second Code Development, 5) Technical SEO & Schema Integration, and 6) Cloud Deployment & Growth Audit."
  },
  {
    q: "Which client types and industry sectors does Yasir Jamal work with?",
    a: "Yasir partners with SaaS Startups, AI Companies, Growth-Stage Tech Businesses, Enterprise Brands, Marketing Agencies, and Founders across sectors including Artificial Intelligence, FinTech, Healthcare & MedTech, Real Estate & PropTech, E-Commerce, Education, and Logistics."
  },
  {
    q: "What is Yasir Jamal's global market reach and international collaboration workflow?",
    a: "Yasir has delivered 150+ digital products across 14+ international markets on 4 continents—including Dubai, Abu Dhabi, Saudi Arabia (Riyadh), the United States (New York, California), Canada, United Kingdom (London), Germany, and Australia. Collaboration is 100% direct via Zoom, Google Meet, Figma, and WhatsApp."
  },
  {
    q: "How does Yasir integrate AI tools into the web design and development process?",
    a: "Yasir uses AI-assisted workflows (Claude, ChatGPT, Cursor, Midjourney) during research, code refactoring, and content structuring. This compresses project delivery timelines by up to 50% without compromising human craftsmanship or design precision."
  },
  {
    q: "What design and prototyping software does Yasir Jamal use daily?",
    a: "Yasir relies on Figma for wireframing, high-fidelity UI design, design token architecture, and interactive prototyping, complemented by Adobe Creative Suite, Framer, and modern code editors."
  },
  {
    q: "Does Yasir Jamal offer full-time, contract, or fractional Product Designer services?",
    a: "Yes. In addition to fixed-price project engagements, Yasir is available for fractional Senior Product Designer retainers, contract UX consulting, and strategic advisory roles for growing companies."
  },
  {
    q: "What makes Yasir's design process conversion-rate focused (CRO)?",
    a: "Every visual element, typography hierarchy, button placement, and form length is justified by behavioral psychology and UX analytics to reduce cognitive load and guide visitors toward primary conversion goals."
  },
  {
    q: "Where is Yasir Jamal located in Dubai, and can we meet in person?",
    a: "Yasir is registered in Dubai Media City, UAE. In-person meetings are available for Dubai and Abu Dhabi clients, alongside seamless remote video collaboration for international teams."
  },
  {
    q: "What is the difference between a graphic designer and a Senior Product Designer like Yasir?",
    a: "Graphic designers focus purely on static aesthetics. A Senior Product Designer combines user research, business strategy, technical architecture, interaction design, and conversion analytics to build functional digital products that drive measurable revenue."
  },
  {
    q: "How does Yasir ensure websites comply with UAE accessibility and enterprise standards?",
    a: "Every site is built adhering to WCAG 2.1 AA accessibility guidelines, semantic HTML landmarks, responsive mobile breakpoints, and high contrast ratios for universal usability across devices."
  },
  {
    q: "Has Yasir worked with notable international companies and regional UAE brands?",
    a: "Yes. Yasir's career includes work and verified recommendations from World Food Programme, Justlife, Rocket Internet, Dubizzle, Ajman Free Zone, Starlinks, and international startups across 14+ markets."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": aboutFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
    <Schema title={seoTitle} description={seoDescription} url={pageUrl} type="LocalBusiness" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <main class="w-full bg-[#f8fafc] text-slate-900 font-elegant selection:bg-[#1559E7] selection:text-white">

    <!-- 1. HERO SECTION: Light Modern Gradient & Interactive Spotlight with Centered Typography Only -->
    <section class="relative w-full min-h-[85vh] sm:min-h-[90vh] flex flex-col items-center justify-center text-center px-6 py-20 bg-gradient-to-b from-slate-50 via-blue-50/40 to-white border-b border-slate-100 font-elegant overflow-hidden group" id="about-hero-section">
      
      <!-- Ambient Gradient Floating Orbs -->
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-[#1559E7]/15 rounded-full blur-[100px] pointer-events-none animate-pulse"></div>
      <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-[#25D366]/10 rounded-full blur-[100px] pointer-events-none animate-pulse" style="animation-delay: 2s;"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-100/30 rounded-full blur-[140px] pointer-events-none"></div>

      <!-- Mouse Tracking Interactive Spotlight (Follows Cursor) -->
      <div id="hero-spotlight" class="absolute w-80 h-80 rounded-full bg-blue-400/10 blur-3xl pointer-events-none transition-opacity duration-500 opacity-0 group-hover:opacity-100" style="transform: translate(-50%, -50%);"></div>

      <div class="max-w-5xl mx-auto flex flex-col items-center justify-center my-auto relative z-10">
        
        <!-- Big Centered "Hi there / I am Yasir." Headline Only (Fluid Responsive Scaling) -->
        <h1 class="text-4xl sm:text-6xl md:text-8xl lg:text-[9.5rem] font-bold tracking-tight text-[#01013E] leading-[0.95] text-center font-elegant select-none transition-transform duration-500 hover:scale-[1.01]">
          <span class="block hover:text-[#1559E7] transition-colors duration-300 cursor-default">Hi there</span>
          <span class="block cursor-default">I am Yasir<span class="text-[#1559E7] inline-block hover:scale-125 transition-transform duration-300">.</span></span>
        </h1>

      </div>
    </section>

    <!-- Client-side Interactive Mouse Spotlight Script -->
    <script>
      const heroSection = document.getElementById('about-hero-section');
      const spotlight = document.getElementById('hero-spotlight');

      if (heroSection && spotlight) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          spotlight.style.left = `${x}px`;
          spotlight.style.top = `${y}px`;
        });
      }
    </script>

    <!-- 2. MISSION STATEMENT BANNER (MATCHES HOMEPAGE MEET YASIR JAMAL DESIGN) -->
    <section class="w-full px-4 sm:px-6 md:px-8 py-16 font-elegant">
      <div class="relative w-full rounded-[2.5rem] overflow-hidden min-h-[500px] md:min-h-[580px] shadow-2xl flex flex-col justify-end p-8 sm:p-14 md:p-20 group">
        <img 
          src="/images/yasir_about.webp" 
          alt="Yasir Jamal - My Mission Background" 
          width="800" 
          height="600" 
          loading="lazy" 
          decoding="async" 
          class="absolute inset-0 w-full h-full object-cover object-[center_25%] group-hover:scale-[1.02] transition-transform duration-700 z-0" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/75 to-slate-950/30 z-0"></div>

        <div class="relative z-10 max-w-5xl">
          <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-[#F6CD0B] mb-3 block">
            My Mission
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-light text-white tracking-tight leading-snug mb-4">
            &ldquo;My mission is to help businesses around the world create digital products that users enjoy, search engines understand, and AI assistants confidently recommend.&rdquo;
          </h2>
          <p class="text-slate-200 text-xs sm:text-sm md:text-base font-light leading-relaxed mb-6 max-w-3xl">
            Every website and product I design is engineered with a relentless focus on usability, sub-second code performance, accessibility, search discoverability, and measurable business growth.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a 
              href="https://wa.me/971552600494" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 bg-white text-[#01013E] px-7 py-3.5 rounded-full text-xs sm:text-sm font-semibold hover:bg-slate-100 transition-all shadow-md"
            >
              <span>Schedule a Discovery Video Call</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 1.5 INTERACTIVE WHO IS YASIR JAMAL SECTION (OPTIMIZED BALANCED TYPOGRAPHY + SMOOTH SCROLL SPY) -->
    <section class="py-16 sm:py-24 bg-[#f8fafc] border-b border-slate-200/80 font-elegant relative" id="who-is-yasir-jamal">
      <div class="max-w-7xl mx-auto px-6 sm:px-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          
          <!-- LEFT COLUMN: STICKY HEADER & SCROLL-SPY MENU -->
          <div class="lg:col-span-5 sticky top-28 self-start h-fit space-y-6 pr-0 lg:pr-4">
            
            <div>
              <span class="text-xs font-semibold uppercase tracking-widest text-[#1559E7] mb-2 block">
                Overview &amp; Background
              </span>

              <h2 class="text-xl sm:text-2xl font-medium text-slate-900 tracking-tight leading-snug mb-3">
                Who is Yasir Jamal
              </h2>

              <p class="text-slate-600 text-xs sm:text-sm font-light leading-relaxed">
                I’m a Senior Product Designer with 15+ years of experience designing digital products and experiences across product design, UX, UI, web, technology, and business.
              </p>
            </div>

            <!-- Interactive Left Navigation Menu (Smooth Scroll Spy: Horizontal Swipe on Mobile, Vertical Sticky Sidebar on Desktop) -->
            <div class="flex lg:flex-col overflow-x-auto lg:overflow-x-visible pb-2 lg:pb-0 gap-1.5 pt-1 -mx-2 px-2 sm:mx-0 sm:px-0 no-scrollbar snap-x" id="philosophy-nav">
              <a 
                href="#about-yasir-jamal"
                class="phil-nav-btn active-phil-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="about-yasir-jamal"
              >
                <span>About Yasir Jamal</span>
                <span class="arrow-icon text-xs transition-transform duration-300 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#website-changed-thinking"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="website-changed-thinking"
              >
                <span>The Website That Changed How I Think About Products</span>
                <span class="arrow-icon text-xs transition-transform duration-300 shrink-0 ml-2 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#from-interfaces-to-systems"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="from-interfaces-to-systems"
              >
                <span>From Interfaces to Systems</span>
                <span class="arrow-icon text-xs transition-transform duration-300 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#working-on-namshi"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="working-on-namshi"
              >
                <span>Working on Namshi</span>
                <span class="arrow-icon text-xs transition-transform duration-300 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#how-i-approach-complex-problems"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="how-i-approach-complex-problems"
              >
                <span>How I Approach Complex Problems</span>
                <span class="arrow-icon text-xs transition-transform duration-300 shrink-0 ml-2 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#i-design-beyond-the-screen"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="i-design-beyond-the-screen"
              >
                <span>I Design Beyond the Screen</span>
                <span class="arrow-icon text-xs transition-transform duration-300 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#what-i-bring-to-a-product-team"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="what-i-bring-to-a-product-team"
              >
                <span>What I Bring to a Product Team</span>
                <span class="arrow-icon text-xs transition-transform duration-300 shrink-0 ml-2 hidden lg:inline-block">&rarr;</span>
              </a>

              <a 
                href="#still-evolving"
                class="phil-nav-btn shrink-0 whitespace-nowrap lg:whitespace-normal text-left px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all duration-300 flex items-center justify-between cursor-pointer border block no-underline snap-start"
                data-target="still-evolving"
              >
                <span>Still Evolving</span>
                <span class="arrow-icon text-xs transition-transform duration-300 hidden lg:inline-block">&rarr;</span>
              </a>
            </div>

          </div>

          <!-- RIGHT COLUMN: CONTINUOUS ALL-TEXT VERTICAL SCROLL -->
          <div class="lg:col-span-7 space-y-12 sm:space-y-16 pt-1 lg:pt-2">
            
            <!-- Section 1: About Yasir Jamal -->
            <div id="about-yasir-jamal" class="phil-section scroll-mt-28 sm:scroll-mt-32 space-y-4 pt-1">
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight">
                About Yasir Jamal
              </h3>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I’m a Senior Product Designer with 15+ years of experience designing digital products and experiences across product design, UX, UI, web, technology, and business.
              </p>
              
              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                My career has always sat at the intersection of design and technology.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I started working professionally in Dubai in 2008, at around 18, designing websites and digital experiences at an advertising agency. At the same time, I was developing a strong technical foundation in HTML, CSS, and JavaScript and learning from an experienced web specialist working at a major media company.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                That early combination shaped how I think about design.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I've never seen the interface as the entire product.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I want to understand what is happening behind it, why the experience exists, what the user is trying to accomplish, how the business works, and what the technology needs to support.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                That perspective has stayed with me throughout my career as my work evolved from web and interface design into UX and product design.
              </p>
            </div>

            <!-- Section 2: The Website That Changed How I Think About Products -->
            <div id="website-changed-thinking" class="phil-section scroll-mt-28 sm:scroll-mt-32 space-y-4 pt-10 border-t border-slate-200/80">
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight">
                The Website That Changed How I Think About Products
              </h3>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                Around 2010, I built my own portfolio website.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I had designed it. I had built it. I put it online.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                And almost nobody visited.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                It was one of the most valuable failures of my early career.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                A friend introduced me to SEO, and I began studying how people searched and how search engines understood websites. I implemented what I learned and eventually reached the first page of Google for relevant design searches.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                The result was tangible: my website began generating two or three enquiries a day without paid advertising.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                That experience taught me something that has influenced my thinking ever since:
              </p>

              <p class="text-slate-900 text-base sm:text-lg font-normal italic border-l-2 border-[#1559E7] pl-4 my-3 leading-relaxed">
                &ldquo;Building a product and getting people to use it are different problems.&rdquo;
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                A product exists within a larger system of discovery, user intent, business objectives, technology, experience, and outcomes.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                That is one of the reasons I naturally think beyond the interface today.
              </p>
            </div>

            <!-- Section 3: From Interfaces to Systems -->
            <div id="from-interfaces-to-systems" class="phil-section scroll-mt-28 sm:scroll-mt-32 space-y-4 pt-10 border-t border-slate-200/80">
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight">
                From Interfaces to Systems
              </h3>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                As the products I worked on became more complex, my role evolved with them.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I moved deeper into UX, interaction design, information architecture, UI, and product design.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                At the same time, my technical background continued to influence my work. I've worked with web technologies and platforms including HTML, CSS, JavaScript, WordPress, and Laravel, and I've spent years working closely with developers to take products from design into implementation.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                That experience taught me to think about the system behind every interface:
              </p>

              <ul class="space-y-2.5 my-3 pl-2 text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>What data drives this experience?</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>What are the business rules?</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>What happens in different states?</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>What are the edge cases?</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>What does engineering need to support?</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>Where are the technical constraints?</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>Where can we simplify the experience without compromising the underlying system?</span>
                </li>
              </ul>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                I don't believe designers need to be engineers.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                But I believe great product designers should be technically fluent enough to understand the systems they are designing and have meaningful conversations about trade-offs with engineering.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                That is an important part of how I work.
              </p>
            </div>

            <!-- Section 4: Working on Namshi -->
            <div id="working-on-namshi" class="phil-section scroll-mt-28 sm:scroll-mt-32 space-y-4 pt-10 border-t border-slate-200/80">
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight">
                Working on Namshi
              </h3>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                A defining chapter of my career was working on Namshi, Rocket Internet's ecommerce venture in the Middle East.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                Working in that environment gave me experience inside a fast-moving technology startup, collaborating with designers, developers, managers, and other disciplines to build and evolve a real digital product.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                It reinforced something that became central to my approach:
              </p>

              <p class="text-slate-900 text-base sm:text-lg font-normal italic border-l-2 border-[#1559E7] pl-4 my-3 leading-relaxed">
                &ldquo;Product design is a decision-making discipline.&rdquo;
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                The work isn't simply about producing polished screens.
              </p>

              <p class="text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                It's about understanding a problem deeply, identifying what matters, balancing competing constraints, exploring possible solutions, and helping a multidisciplinary team converge on the right one.
              </p>

              <ul class="space-y-2.5 my-3 pl-2 text-slate-600 text-sm sm:text-base font-light leading-relaxed">
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>Users have needs.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>Businesses have objectives.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-[#1559E7] font-bold text-sm mt-0.5">•</span>
                  <span>Engineering has constraints.</span>
                </li>
