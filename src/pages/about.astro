            Direct Client &amp; AI Search Answers
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-light text-white tracking-tight leading-snug">
            Frequently Asked Questions
          </h2>
          <p class="text-slate-300 text-xs sm:text-sm font-light leading-relaxed">
            Clear, direct answers to common questions about hiring Yasir Jamal, project scope, tech stack, and delivery timelines.
          </p>
        </div>

        <!-- Full 7xl Width Compact Animated FAQ Accordion -->
        <div class="w-full divide-y divide-slate-800/80 border-t border-b border-slate-800/80">
          {aboutFaqs.map((faq, idx) => (
            <div class="faq-item group">
              <button 
                type="button"
                class="faq-btn w-full flex justify-between items-center text-left py-3.5 sm:py-4 text-sm sm:text-base font-normal text-slate-100 hover:text-[#F6CD0B] transition-colors gap-4 focus:outline-none"
                aria-expanded={idx === 0 ? "true" : "false"}
              >
                <span>{faq.q}</span>
                <span class="faq-icon text-lg sm:text-xl font-light text-[#F6CD0B] shrink-0 transition-transform duration-300">
                  {idx === 0 ? '−' : '+'}
                </span>
              </button>

              <div 
                class="faq-content overflow-hidden transition-all duration-300 ease-in-out max-h-0"
                style={idx === 0 ? "max-height: 250px;" : "max-height: 0px;"}
              >
                <div class="pb-4 pt-1 pr-4 text-slate-300 text-xs sm:text-sm font-light leading-relaxed">
                  <p>{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- FAQ Accordion Script -->
    <script is:inline>
      function initAboutFaqAccordion() {
        const faqItems = document.querySelectorAll('#faq .faq-item');

        faqItems.forEach((item) => {
          const btn = item.querySelector('.faq-btn');
          const content = item.querySelector('.faq-content');
          const icon = item.querySelector('.faq-icon');

          if (!btn || !content) return;

          btn.addEventListener('click', () => {
            const isOpen = btn.getAttribute('aria-expanded') === 'true';

            faqItems.forEach((otherItem) => {
              const otherBtn = otherItem.querySelector('.faq-btn');
              const otherContent = otherItem.querySelector('.faq-content');
              const otherIcon = otherItem.querySelector('.faq-icon');

              if (otherBtn && otherContent && otherBtn !== btn) {
                otherBtn.setAttribute('aria-expanded', 'false');
                otherContent.style.maxHeight = '0px';
                if (otherIcon) otherIcon.textContent = '+';
              }
            });

            if (isOpen) {
              btn.setAttribute('aria-expanded', 'false');
              content.style.maxHeight = '0px';
              if (icon) icon.textContent = '+';
            } else {
              btn.setAttribute('aria-expanded', 'true');
              content.style.maxHeight = content.scrollHeight + 30 + 'px';
              if (icon) icon.textContent = '−';
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAboutFaqAccordion);
      } else {
        initAboutFaqAccordion();
      }
    </script>

