      </style>

      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const navLinks = document.querySelectorAll('.phil-nav-btn');
          const sections = document.querySelectorAll('.phil-section');

          // Smooth Click Handler
          navLinks.forEach(link => {
            link.addEventListener('click', (e) => {
              e.preventDefault();
              const targetId = link.getAttribute('data-target');
              const targetSection = document.getElementById(targetId);
              if (targetSection) {
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          });

          // Scroll Spy Observer to highlight current active section
          const observerOptions = {
            root: null,
            rootMargin: '-15% 0px -65% 0px',
            threshold: 0
          };

          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const activeId = entry.target.getAttribute('id');
                navLinks.forEach(link => {
                  if (link.getAttribute('data-target') === activeId) {
                    link.classList.add('active-phil-btn');
                  } else {
                    link.classList.remove('active-phil-btn');
                  }
                });
              }
            });
          }, observerOptions);

          sections.forEach(section => observer.observe(section));
        });
      </script>
    </section>





