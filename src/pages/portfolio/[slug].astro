const { project } = Astro.props;
const pageUrl = `https://lawngreen-toad-836930.hostingersite.com/portfolio/${project.slug}`;
---

<Layout title={`${project.title} - Case Study | Yasir Jamal`}>
  <Fragment slot="head">
    <SEO 
      title={`${project.title} | Case Study by Yasir Jamal`} 
      description={project.description} 
      url={pageUrl} 
    />
  </Fragment>

  <!-- Clean Pure White Top Header Banner (No Fill Color) -->
  <section class="w-full bg-white text-[#01013E] pt-32 pb-16 sm:pt-40 sm:pb-20 font-elegant relative border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      
      <!-- Breadcrumbs -->
      <nav class="flex justify-center items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="/" class="hover:text-[#1559E7] transition-colors">Home</a>
        <span>&rsaquo;</span>
        <a href="/portfolio/" class="hover:text-[#1559E7] transition-colors">Case Studies</a>
        <span>&rsaquo;</span>
        <span class="text-slate-900 font-semibold">{project.title}</span>
      </nav>

      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 text-[#1559E7] text-xs font-semibold uppercase tracking-widest mb-6 border border-slate-200/80">
        {project.category}
      </span>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-light text-[#01013E] tracking-tight leading-tight mb-6">
        {project.title}
      </h1>

      <p class="text-slate-600 text-base sm:text-xl font-light leading-relaxed max-w-3xl mx-auto mb-8">
        {project.description}
      </p>

      {project.liveUrl && (
        <a 
          href={project.liveUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2.5 px-9 py-4 bg-[#1559E7] hover:bg-[#01013E] text-white rounded-full text-xs sm:text-sm font-semibold transition-all shadow-xl hover:shadow-2xl"
        >
          <span>Visit Live Site</span>
          <span>&rarr;</span>
        </a>
      )}
    </div>
  </section>

  <!-- Main Content & Seamless Showcase Section -->
  <main class="w-full bg-[#f8fafc] py-16 sm:py-24 font-elegant text-slate-800 leading-relaxed">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 sm:space-y-20">
      
      <!-- Pure Minimalist Project Highlights (No Box, No Card Border, Clean Grid) -->
      <div class="max-w-5xl mx-auto py-2 w-full">
        <span class="text-[11px] font-bold text-[#1559E7] uppercase tracking-widest mb-4 block">Case Study Highlights</span>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-200">
          {project.highlights.map((item, idx) => (
            <div class="flex flex-col gap-1.5">
              <span class="text-xs font-bold text-slate-400">0{idx + 1}</span>
              <p class="text-sm sm:text-base text-slate-800 font-light leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Seamless Single Browser Frame (Zero Gap Continuous Stacked Image Slices) -->
      <div class="space-y-10 max-w-7xl mx-auto">
        <div class="text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-[#1559E7] mb-2 block">Visual Showcase</span>
          <h2 class="text-2xl sm:text-4xl font-light text-[#01013E] tracking-tight">Full Page Design & Experience Artifacts</h2>
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-slate-200/90">
          <!-- Single Browser Header Bar -->
          <div class="bg-slate-100 px-6 py-3.5 border-b border-slate-200 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block"></span>
            </div>
            <div class="px-6 py-1 rounded-full bg-white text-xs font-medium text-slate-500 border border-slate-200/80 shadow-inner">
              {project.domain}
            </div>
            <div class="w-12"></div>
          </div>

          <!-- Seamless Stack of Sliced Images with 0 Gap / 0 Margin -->
          <div class="w-full flex flex-col space-y-0 bg-white">
            {project.gallery.map((imgSrc, i) => (
              <img 
                src={imgSrc} 
                alt={`${project.title} Case Study Image ${i + 1}`} 
                class="w-full h-auto object-cover block m-0 p-0 border-none leading-none select-none" 
                loading="lazy" 
              />
            ))}
          </div>
        </div>
      </div>

      <!-- Back to Case Studies Navigation -->
      <div class="text-center pt-16 border-t border-slate-200">
        <a 
          href="/portfolio/" 
          class="inline-flex items-center gap-2.5 px-10 py-4.5 bg-[#01013E] hover:bg-slate-900 text-white rounded-full text-xs sm:text-sm font-bold transition-all shadow-xl hover:scale-105"
        >
          <span>&larr; Back to All Case Studies</span>
        </a>
      </div>

    </div>
  </main>
</Layout>
