---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 - Page Not Found | Yasir Jamal" 
  description="The page you are looking for does not exist or has been moved. Explore selected works and digital product case studies by Yasir Jamal."
>
  <main class="min-h-screen bg-[#03050d] text-white flex flex-col items-center justify-center px-6 py-24 relative overflow-hidden font-elegant">
    
    <!-- Background Ambient Glows -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#1559E7]/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>

    <div class="max-w-2xl mx-auto text-center relative z-10 space-y-8">
      
      <!-- Big 404 Display -->
      <div class="space-y-2">
        <span class="text-xs sm:text-sm font-mono text-cyan-400 uppercase tracking-widest block">
          Error 404 &bull; Page Not Found
        </span>
        <h1 class="text-7xl sm:text-9xl font-extralight tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-cyan-300">
          404
        </h1>
      </div>

      <!-- Description -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-light text-white tracking-tight">
          This page has moved or doesn't exist.
        </h2>
        <p class="text-slate-400 text-sm sm:text-base font-light leading-relaxed max-w-md mx-auto">
          The link you followed may be outdated. You can explore featured product design case studies or head back to the homepage.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#1559E7] hover:bg-blue-600 text-white rounded-full text-xs sm:text-sm font-semibold transition-all shadow-[0_10px_25px_rgba(21,89,231,0.4)]"
        >
          <span>&larr; Return to Homepage</span>
        </a>
        
        <a 
          href="/portfolio/" 
          class="inline-flex items-center gap-2 px-7 py-3.5 bg-white/10 hover:bg-white/15 text-white border border-white/15 rounded-full text-xs sm:text-sm font-medium transition-all"
        >
          <span>Explore Portfolio</span>
        </a>

        <a 
          href="https://wa.me/971552600494" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 rounded-full text-xs sm:text-sm font-medium transition-all"
        >
          <span>WhatsApp Yasir</span>
        </a>
      </div>

    </div>
  </main>
</Layout>
