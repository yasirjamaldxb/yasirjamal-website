---
import Layout from '../layouts/Layout.astro';

const colorTokens = [
  {
    name: "Dark Navy",
    hex: "#01013E",
    variable: "var(--color-brand-navy)",
    role: "Primary Brand Canvas",
    usage: "Midnight Blue — Primary page headers, typography, dark section fills, and high-contrast footers.",
    contrast: "WCAG AAA Pass (18.4:1 on White)",
    bgClass: "bg-[#01013E]",
    textClass: "text-white"
  },
  {
    name: "Electric Azure",
    hex: "#1559E7",
    variable: "var(--color-brand-azure)",
    role: "Primary Accent & Action",
    usage: "Electric Blue — Primary CTA buttons, interactive links, active tabs, and vector SVG icon fills.",
    contrast: "WCAG AA Pass (4.8:1 on White)",
    bgClass: "bg-[#1559E7]",
    textClass: "text-white"
  },
  {
    name: "Sunshine Gold",
    hex: "#F6CD0B",
    variable: "var(--color-brand-yellow)",
    role: "Warm Highlight & Rating",
    usage: "Electric Gold — 5-star rating stars, highlight badges, warm pill dots, and dark section callouts.",
    contrast: "WCAG AA Pass (11.2:1 on Navy)",
    bgClass: "bg-[#F6CD0B]",
    textClass: "text-[#01013E]"
  },
  {
    name: "Ice Blue",
    hex: "#B7D5DF",
    variable: "var(--color-brand-iceblue)",
    role: "Muted Surface & Border",
    usage: "Soft Azure Tint — Subtle card backgrounds, muted borders, tag fills, and secondary surfaces.",
    contrast: "UI Surface Token",
    bgClass: "bg-[#B7D5DF]",
    textClass: "text-[#01013E]"
  }
];

const spacingScale = [
  { label: "xs (4px)", size: "w-1 h-4 bg-[#1559E7]" },
  { label: "sm (8px)", size: "w-2 h-4 bg-[#1559E7]" },
  { label: "md (16px)", size: "w-4 h-4 bg-[#1559E7]" },
  { label: "lg (24px)", size: "w-6 h-4 bg-[#1559E7]" },
  { label: "xl (32px)", size: "w-8 h-4 bg-[#1559E7]" },
  { label: "2xl (48px)", size: "w-12 h-4 bg-[#1559E7]" },
  { label: "3xl (64px)", size: "w-16 h-4 bg-[#1559E7]" },
  { label: "4xl (96px)", size: "w-24 h-4 bg-[#1559E7]" }
];

const radiusScale = [
  { name: "Rounded Normal (12px)", class: "rounded-xl", style: "border-radius: 0.75rem;" },
  { name: "Rounded Medium (16px)", class: "rounded-2xl", style: "border-radius: 1rem;" },
  { name: "Rounded Large (24px)", class: "rounded-3xl", style: "border-radius: 1.5rem;" },
  { name: "Rounded Pill (Full)", class: "rounded-full", style: "border-radius: 9999px;" }
];

const shadowScale = [
  { name: "Subtle Ambient Card", shadow: "shadow-[0_10px_30px_rgba(0,0,0,0.03)]", usage: "Standard default state for bento cards and service containers." },
  { name: "Hover Elevation Glow", shadow: "shadow-[0_15px_35px_rgba(21,89,231,0.07)]", usage: "Active hover state for interactive cards and pricing tiers." },
  { name: "Floating Modal / Dropdown", shadow: "shadow-[0_20px_50px_rgba(0,0,0,0.12)]", usage: "Floating popovers, mobile menus, and sticky navigation headers." }
];

const iconsList = [
  { name: "Custom Experience", usage: "Services Grid", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>` },
  { name: "eCommerce Storefront", usage: "Commerce Architecture", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>` },
  { name: "UI/UX & Product Design", usage: "Figma UI Systems", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>` },
  { name: "Full Stack Engineering", usage: "Astro & Cloud Backend", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>` },
  { name: "Headless CMS Systems", usage: "Visual Page Editing", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>` },
  { name: "Mobile App Engineering", usage: "Native iOS & Android", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>` },
  { name: "Clean Astro Lightning", usage: "Core Web Vitals Card", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>` },
  { name: "Next.js Code Terminal", usage: "Full Stack React Card", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>` },
  { name: "Senior Dev Silhouette", usage: "Zero Middlemen Card", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>` },
  { name: "Sub-Second Speed Trend", usage: "Lighthouse 100 Score", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>` },
  { name: "WhatsApp Chat Bubble", usage: "Direct Conversion Lead", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>` },
  { name: "Custom UI Layout Grid", usage: "Tailored Interface Design", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>` },
  { name: "Technical SEO Magnifying", usage: "Google UAE #1 Ranking", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>` },
  { name: "UAE Location Pointer", usage: "15+ Years Dubai Presence", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>` },
  { name: "Enterprise Shield Badge", usage: "Govt Compliant Security", svg: `<svg class="w-5 h-5 text-[#1559E7]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>` },
  { name: "WhatsApp Official Logo", usage: "Direct Header CTA", svg: `<svg class="w-5 h-5 fill-current text-[#25D366]" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.099 4.019 4.042-1.059z"/></svg>` }
];

const companyLogos = [
  { name: "Ajman Free Zone", src: "/images/company_logos/ajman_free_zone.svg", style: "h-7 max-w-[125px] brightness-0", role: "Government Authority" },
  { name: "World Food Programme", src: "/images/company_logos/world_food.jpg", style: "h-9 max-w-[48px]", role: "United Nations Entity" },
  { name: "Justlife", src: "/images/company_logos/justlife.png", style: "h-8 max-w-[125px]", role: "Home Services Leader" },
  { name: "Rocket Internet", src: "/images/company_logos/rocket_internet.png", style: "h-7 max-w-[115px]", role: "Global Tech Incubator" },
  { name: "Starlinks", src: "/images/company_logos/starlinks.png", style: "h-8 max-w-[130px]", role: "Supply Chain & Logistics" },
  { name: "Dubizzle", src: "/images/company_logos/dubizzle.svg", style: "h-7 max-w-[110px]", role: "Classifieds Marketplace" }
];
---

<Layout title="Design System Architecture & Guidelines | Yasir Jamal Studio">
  
  <main class="w-full bg-white text-slate-900 font-elegant pt-28 pb-32 min-h-screen">
    <div class="max-w-6xl mx-auto px-6 sm:px-8">
      
      <!-- Top Title Header: Tier-1 Minimalist Architecture -->
      <div class="mb-20 pb-10 border-b border-slate-100">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-50 border border-slate-200/80 text-[#1559E7] text-[11px] font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-[#1559E7] animate-pulse"></span>
          Official Studio Design System v2.0
        </div>
        <h1 class="text-4xl sm:text-5xl font-light text-[#01013E] tracking-tight mb-4 leading-tight">
          Design System Architecture & UI Specifications
        </h1>
        <p class="text-slate-500 text-base sm:text-lg font-light max-w-3xl leading-relaxed">
          The foundational blueprint governing Yasir Jamal Web Studio. Built on strict tokenized color variables, responsive typography, spacing scales, form controls, vector SVGs, and minimalist light hover states.
        </p>
      </div>

      <div class="space-y-28">
        
        <!-- SECTION 01: BRAND COLOR SYSTEM & ACCESSIBILITY MATRIX -->
        <section class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#1559E7] font-semibold block mb-1">01 — Color Architecture</span>
              <h2 class="text-2xl font-light text-[#01013E] tracking-tight">Brand Color Tokens & WCAG Contrast Scale</h2>
            </div>
            <p class="text-xs text-slate-400 font-light">4 immutable tokens defining our visual identity.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {colorTokens.map(token => (
              <div class="bg-white rounded-2xl p-5 border border-slate-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.03)] space-y-4 hover:border-[#1559E7]/30 hover:bg-[#1559E7]/[0.015] transition-all duration-300">
                <div class={`h-28 rounded-xl ${token.bgClass} w-full shadow-inner flex items-end justify-between p-3`}>
                  <span class={`text-xs font-mono px-2 py-0.5 rounded backdrop-blur-sm ${token.textClass} bg-black/20`}>{token.hex}</span>
                  <span class="text-[9px] font-mono uppercase tracking-wider bg-white/30 text-[#01013E] px-1.5 py-0.5 rounded font-bold">{token.role}</span>
                </div>
                <div class="space-y-1.5">
                  <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-[#01013E]">{token.name}</h3>
                    <span class="text-[10px] font-mono text-emerald-600 font-semibold">{token.contrast}</span>
                  </div>
                  <p class="text-xs text-slate-500 font-light leading-relaxed">{token.usage}</p>
                  <span class="text-[10px] font-mono text-slate-400 block pt-1 select-all">{token.variable}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 02: TYPOGRAPHY HIERARCHY -->
        <section class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#1559E7] font-semibold block mb-1">02 — Typography</span>
              <h2 class="text-2xl font-light text-[#01013E] tracking-tight">Typography Scale & Typeface Tokens</h2>
            </div>
            <p class="text-xs text-slate-400 font-light">Outfit Display & Inter Body Typefaces.</p>
          </div>

          <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.02)] space-y-8">
            <div class="pb-6 border-b border-slate-100 space-y-2">
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Display H1 — Outfit Light • 48px / 1.15 line-height • class="font-light text-4xl sm:text-5xl text-[#01013E]"</span>
              <h1 class="text-3xl sm:text-5xl font-light text-[#01013E] tracking-tight leading-tight">
                Senior Web Engineering & Custom Studio
              </h1>
            </div>
            <div class="pb-6 border-b border-slate-100 space-y-2">
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Section H2 — Outfit Light • 32px / 1.2 line-height • class="font-light text-2xl sm:text-3xl text-[#01013E]"</span>
              <h2 class="text-2xl sm:text-3xl font-light text-[#01013E] tracking-tight">
                Engineering Digital Excellence in Dubai
              </h2>
            </div>
            <div class="pb-6 border-b border-slate-100 space-y-2">
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Card Title H3 — Outfit Semibold • 18px • class="font-semibold text-lg text-[#01013E]"</span>
              <h3 class="text-lg font-semibold text-[#01013E]">
                Sub-Second Core Web Vitals Optimization
              </h3>
            </div>
            <div class="space-y-2">
              <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Body Text — Inter Light • 15px / 1.6 line-height • class="text-slate-600 font-light"</span>
              <p class="text-sm sm:text-base text-slate-600 font-light leading-relaxed max-w-3xl">
                We design custom websites built from scratch to elevate brand authority, capture audience attention, and convert visitors into clients with sub-second page performance.
              </p>
            </div>
          </div>
        </section>

        <!-- SECTION 03: SPACING, GRID & BREAKPOINT SCALE -->
        <section class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#1559E7] font-semibold block mb-1">03 — Layout & Spacing Scale</span>
              <h2 class="text-2xl font-light text-[#01013E] tracking-tight">System Spacing & Container Grid</h2>
            </div>
            <p class="text-xs text-slate-400 font-light">Harmonic 8-pt spatial grid tokens.</p>
          </div>

          <div class="bg-white rounded-3xl p-8 border border-slate-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.02)] space-y-6">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              {spacingScale.map(space => (
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 space-y-2">
                  <span class="text-xs font-mono font-semibold text-[#01013E] block">{space.label}</span>
                  <div class={`${space.size} rounded-sm`}></div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- SECTION 04: BORDER RADIUS & AMBIENT ELEVATION SHADOWS -->
        <section class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#1559E7] font-semibold block mb-1">04 — Radius & Shadow Tokens</span>
              <h2 class="text-2xl font-light text-[#01013E] tracking-tight">Border Radius & Elevation Primitives</h2>
            </div>
            <p class="text-xs text-slate-400 font-light">Soft rounded geometry & ambient elevation.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Radius Primitives -->
            <div class="bg-white rounded-3xl p-8 border border-slate-200/70 shadow-sm space-y-4">
              <h3 class="text-sm font-semibold text-[#01013E]">Border Radius Scale</h3>
              <div class="grid grid-cols-2 gap-4">
                {radiusScale.map(rad => (
                  <div class={`p-4 bg-slate-50 border border-slate-200/80 ${rad.class} space-y-1`}>
                    <span class="text-xs font-semibold text-[#01013E] block">{rad.name}</span>
                    <span class="text-[10px] font-mono text-slate-400 block">{rad.style}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Elevation Shadow Primitives -->
            <div class="bg-white rounded-3xl p-8 border border-slate-200/70 shadow-sm space-y-4">
              <h3 class="text-sm font-semibold text-[#01013E]">Elevation & Shadow Tokens</h3>
              <div class="space-y-3">
                {shadowScale.map(sh => (
                  <div class={`p-4 bg-white rounded-2xl border border-slate-100 ${sh.shadow} space-y-1`}>
                    <span class="text-xs font-semibold text-[#01013E] block">{sh.name}</span>
                    <span class="text-[10px] text-slate-400 font-light block">{sh.usage}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 05: VECTOR SVG ICON SYSTEM (16 TOKENS) -->
        <section class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#1559E7] font-semibold block mb-1">05 — Complete Icon System</span>
              <h2 class="text-2xl font-light text-[#01013E] tracking-tight">Full Vector SVG Icon Library (16 Tokens)</h2>
            </div>
            <p class="text-xs text-slate-400 font-light">100% standardized vector icons styled in Electric Azure (#1559E7).</p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-5">
            {iconsList.map(iconItem => (
              <div class="bg-white rounded-2xl p-5 border border-slate-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.02)] space-y-3 flex flex-col justify-between hover:border-[#1559E7]/30 hover:bg-[#1559E7]/[0.015] hover:-translate-y-0.5 transition-all duration-300 group">
                <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <Fragment set:html={iconItem.svg} />
                </div>
                <div>
                  <h3 class="text-xs font-bold text-[#01013E] leading-snug">{iconItem.name}</h3>
                  <span class="text-[10px] text-slate-400 font-light block">{iconItem.usage}</span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 06: FORM & INPUT CONTROL PRIMITIVES -->
        <section class="space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between pb-4 border-b border-slate-100 gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-[#1559E7] font-semibold block mb-1">06 — Form Primitives</span>
              <h2 class="text-2xl font-light text-[#01013E] tracking-tight">Interactive Form Controls & Inputs</h2>
            </div>
            <p class="text-xs text-slate-400 font-light">Minimalist input controls designed for quote proposal forms.</p>
          </div>

          <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/70 shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              
              <!-- Text Input Control -->
              <div class="space-y-2">
                <label class="text-xs font-medium text-[#01013E] block">Full Name Input</label>
