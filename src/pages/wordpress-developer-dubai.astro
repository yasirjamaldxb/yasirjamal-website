                aria-expanded={idx === 0 ? "true" : "false"}
              >
                <span>{faq.q}</span>
                <span class="faq-icon text-lg sm:text-xl font-light text-[#F6CD0B] shrink-0 transition-transform duration-300">
                  {idx === 0 ? '−' : '+'}
                </span>
              </button>

              <div 
                class="faq-content overflow-hidden transition-all duration-300 ease-in-out max-h-0"
                style={idx === 0 ? "max-height: 250px;" : "max-height: 0px;"}
              >
                <div class="pb-5 pt-1 pr-4 text-slate-300 text-xs sm:text-sm font-light leading-relaxed">
                  <p>{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- FAQ Accordion Script -->
    <script>
      function initWpFaqAccordion() {
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach((item) => {
          const btn = item.querySelector('.faq-btn');
          const content = item.querySelector('.faq-content') as HTMLElement;
          const icon = item.querySelector('.faq-icon');

          if (!btn || !content) return;

          btn.addEventListener('click', () => {
            const isOpen = btn.getAttribute('aria-expanded') === 'true';

            faqItems.forEach((otherItem) => {
              const otherBtn = otherItem.querySelector('.faq-btn');
              const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
              const otherIcon = otherItem.querySelector('.faq-icon');

              if (otherBtn && otherContent && otherBtn !== btn) {
                otherBtn.setAttribute('aria-expanded', 'false');
                otherContent.style.maxHeight = '0px';
                if (otherIcon) otherIcon.textContent = '+';
              }
            });

            if (isOpen) {
              btn.setAttribute('aria-expanded', 'false');
              content.style.maxHeight = '0px';
              if (icon) icon.textContent = '+';
            } else {
              btn.setAttribute('aria-expanded', 'true');
              content.style.maxHeight = content.scrollHeight + 30 + 'px';
              if (icon) icon.textContent = '−';
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWpFaqAccordion);
      } else {
        initWpFaqAccordion();
      }
    </script>


