    <!-- Canvas Animation Script -->
    <script is:inline>
      function initWpHeroCanvas() {
        const canvas = document.getElementById('wp-hero-canvas');
        if (!canvas) return;

        const ctx = canvas.getContext('2d', { alpha: true });
        let width, height, animationFrameId;
        const isMobile = window.innerWidth < 768;

        const resize = () => {
          width = canvas.width = canvas.offsetWidth;
          height = canvas.height = canvas.offsetHeight;
        };

        resize();
        window.addEventListener('resize', resize, { passive: true });

        const particles = [];
        const particleCount = isMobile ? 30 : 65;

        for (let i = 0; i < particleCount; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 1.8 + 0.6,
            vx: (Math.random() - 0.5) * 0.45,
            vy: (Math.random() - 0.5) * 0.45,
            alpha: Math.random() * 0.5 + 0.2
          });
        }

        function animate() {
          ctx.clearRect(0, 0, width, height);

          for (let i = 0; i < particles.length; i++) {
            const p1 = particles[i];
            p1.x += p1.vx;
            p1.y += p1.vy;

            if (p1.x < 0) p1.x = width;
            if (p1.x > width) p1.x = 0;
            if (p1.y < 0) p1.y = height;
            if (p1.y > height) p1.y = 0;

            ctx.beginPath();
            ctx.arc(p1.x, p1.y, p1.radius, 0, Math.PI * 2);
            ctx.fillStyle = '#38bdf8';
            ctx.globalAlpha = p1.alpha;
            ctx.fill();

            for (let j = i + 1; j < particles.length; j++) {
              const p2 = particles[j];
              const dx = p1.x - p2.x;
              const dy = p1.y - p2.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              const maxDist = isMobile ? 85 : 120;

              if (dist < maxDist) {
                ctx.beginPath();
                ctx.moveTo(p1.x, p1.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.strokeStyle = '#1559E7';
                ctx.globalAlpha = (1 - dist / maxDist) * 0.2;
                ctx.lineWidth = 0.8;
                ctx.stroke();
              }
            }
          }
          ctx.globalAlpha = 1.0;
          animationFrameId = requestAnimationFrame(animate);
        }

        animationFrameId = requestAnimationFrame(animate);

        window.addEventListener('beforeunload', () => {
          if (animationFrameId) cancelAnimationFrame(animationFrameId);
        }, { once: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => setTimeout(initWpHeroCanvas, 20));
      } else {
        setTimeout(initWpHeroCanvas, 20);
