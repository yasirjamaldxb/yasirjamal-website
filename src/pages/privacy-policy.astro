---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "Privacy Policy | Yasir Jamal";
const seoDescription = "Privacy policy and data protection guidelines for Yasir Jamal Product Design & Web Engineering.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/privacy-policy";
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
  </Fragment>

  <main class="w-full bg-slate-50 pt-32 pb-24 font-elegant text-slate-800 leading-relaxed">
    <div class="max-w-3xl mx-auto px-6">
      
      <!-- Simple Title & Last Updated (No Hero Box) -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-light text-slate-900 tracking-tight mb-3">
        Privacy Policy
      </h1>
      <p class="text-xs text-slate-400 font-light mb-12">
        Last Updated: July 2026
      </p>

      <!-- Simple Text Content (No Boxes/Cards) -->
      <div class="space-y-10 text-sm text-slate-600 font-light leading-relaxed">
        
        <div>
          <h2 class="text-base font-bold text-slate-900 mb-2">1. Information We Collect</h2>
          <p>We collect personal information that you voluntarily provide to us when submitting project inquiries, contact forms, or direct messages. This may include your name, email address, phone number, company name, and project specifications.</p>
        </div>

        <div>
          <h2 class="text-base font-bold text-slate-900 mb-2">2. How We Use Your Information</h2>
          <p>The information collected is used exclusively to evaluate project requirements, respond to inquiries, deliver customized proposals, and communicate project updates. We do not sell, rent, or trade your personal information to third parties.</p>
        </div>

        <div>
          <h2 class="text-base font-bold text-slate-900 mb-2">3. Cookies &amp; Analytics</h2>
          <p>Our website uses standard cookies and web analytics tools to understand website traffic, user interactions, and performance metrics to continuously improve our user experience.</p>
        </div>

        <div>
          <h2 class="text-base font-bold text-slate-900 mb-2">4. Data Security</h2>
          <p>We implement industry-standard administrative and technical security measures to safeguard your personal information against unauthorized access, alteration, disclosure, or destruction.</p>
        </div>

        <div>
          <h2 class="text-base font-bold text-slate-900 mb-2">5. Contact Us</h2>
          <p>If you have any questions or concerns regarding this Privacy Policy, please contact us at <a href="mailto:info@yasirjamal.com" class="text-[#1559E7] font-semibold hover:underline">info@yasirjamal.com</a>.</p>
        </div>

      </div>

    </div>
  </main>
</Layout>
