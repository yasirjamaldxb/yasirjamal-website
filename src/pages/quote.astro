---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import SEO from '../components/SEO.astro';

const seoTitle = "Get a Free Web Design Quote | Yasir Jamal Dubai";
const seoDescription = "Request a custom web design and development quote for your Dubai business. Fast response within 2 hours.";
const pageUrl = "https://lawngreen-toad-836930.hostingersite.com/quote";
---

<Layout title={seoTitle}>
  <Fragment slot="head">
    <SEO title={seoTitle} description={seoDescription} url={pageUrl} />
    <Schema title={seoTitle} description={seoDescription} url={pageUrl} type="LocalBusiness" />
  </Fragment>

  <!-- 100% Screen Height Minimalist Container (No Scroll) -->
  <main class="w-full bg-slate-50 text-slate-900 pt-20 pb-8 sm:pt-24 min-h-[calc(100vh-80px)] flex flex-col justify-center font-elegant relative overflow-hidden">
    
    <div class="max-w-3xl mx-auto px-4 sm:px-6 w-full relative z-10">
      
      <!-- Concise Header -->
      <div class="text-center mb-6">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-200/80 text-[#18230b] text-[11px] font-semibold uppercase tracking-wider mb-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#18230b] animate-pulse"></span>
          Fast Response Guaranteed
        </span>
        <h1 class="text-2xl sm:text-3xl font-light text-slate-900 tracking-tight leading-snug mb-1.5">
          Get a Project Quote
        </h1>
        <p class="text-slate-600 text-xs sm:text-sm font-light leading-relaxed max-w-md mx-auto">
          Tell us about your project goals. Simple, fast, and easy on the eyes. No unnecessary paperwork.
        </p>
      </div>

      <!-- No Box / Borderless Seamless Form -->
      <form id="quote-form" class="space-y-4 max-w-2xl mx-auto">
        
        <!-- Service Selection Pills -->
        <div>
          <label class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider block mb-2 text-center">
            Select Service
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="service-selector">
            <button type="button" class="service-pill px-3 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-xs font-medium text-center hover:border-slate-900 transition-all active-pill" data-service="Web Design & SEO">
              Web Design
            </button>
            <button type="button" class="service-pill px-3 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-xs font-medium text-center hover:border-slate-900 transition-all" data-service="eCommerce Store">
              eCommerce
            </button>
            <button type="button" class="service-pill px-3 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-xs font-medium text-center hover:border-slate-900 transition-all" data-service="Web App / Portal">
              Web App
            </button>
            <button type="button" class="service-pill px-3 py-2.5 rounded-xl border border-slate-300 bg-white text-slate-800 text-xs font-medium text-center hover:border-slate-900 transition-all" data-service="SEO & Speed Audit">
              SEO & Speed
            </button>
          </div>
        </div>

        <!-- Name & Contact -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-xs font-medium text-slate-700 block mb-1">Your Name *</label>
            <input 
              type="text" 
              id="user-name"
              placeholder="e.g. Sarah Al-Maktoum" 
              required 
              class="w-full bg-white border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-900 focus:ring-1 focus:ring-slate-900 transition-all shadow-sm" 
            />
          </div>

          <div>
            <label class="text-xs font-medium text-slate-700 block mb-1">Email or WhatsApp *</label>
            <input 
              type="text" 
              id="user-contact"
              placeholder="sarah@company.ae or +971 50 123 4567" 
              required 
              class="w-full bg-white border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-900 focus:ring-1 focus:ring-slate-900 transition-all shadow-sm" 
            />
          </div>
        </div>

        <!-- Budget & Timeline -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-xs font-medium text-slate-700 block mb-1">Estimated Budget</label>
            <select id="user-budget" class="w-full bg-white border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-1 focus:ring-slate-900 transition-all shadow-sm">
              <option value="AED 5,000 - 10,000">AED 5,000 - AED 10,000</option>
              <option value="AED 10,000 - 25,000" selected>AED 10,000 - AED 25,000</option>
              <option value="AED 25,000+">AED 25,000+</option>
            </select>
          </div>

          <div>
            <label class="text-xs font-medium text-slate-700 block mb-1">Target Timeline</label>
            <select id="user-timeline" class="w-full bg-white border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:border-slate-900 focus:ring-1 focus:ring-slate-900 transition-all shadow-sm">
              <option value="As soon as possible">As soon as possible (1-2 weeks)</option>
              <option value="Within 1 month" selected>Within 1 month</option>
              <option value="Flexible timeline">Flexible timeline</option>
            </select>
          </div>
        </div>

        <!-- Details Box -->
        <div>
          <label class="text-xs font-medium text-slate-700 block mb-1">Project Details (Optional)</label>
          <textarea 
            id="user-details"
            rows="2" 
            placeholder="Tell us a few words about your goals..." 
            class="w-full bg-white border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-900 focus:ring-1 focus:ring-slate-900 transition-all shadow-sm resize-none"
          ></textarea>
        </div>

        <!-- WhatsApp Direct Submit Button -->
        <div class="pt-2">
          <button 
            type="submit" 
            class="w-full bg-[#25D366] hover:bg-[#20bd5a] text-white py-3.5 rounded-xl text-xs font-bold transition-all shadow-md flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Send Request via WhatsApp &rarr;
          </button>
        </div>

      </form>

    </div>
  </main>

  <!-- Form Interactivity Script -->
  <script>
    let selectedService = "Web Design & SEO";

    // Handle Service Pill Selection
    const pills = document.querySelectorAll('.service-pill');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => {
          p.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
          p.classList.add('bg-white', 'text-slate-800', 'border-slate-300');
        });
        pill.classList.remove('bg-white', 'text-slate-800', 'border-slate-300');
        pill.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        selectedService = pill.getAttribute('data-service') || "Web Design & SEO";
      });
    });

    // Handle Direct WhatsApp Submission
    const form = document.getElementById('quote-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('user-name') as HTMLInputElement)?.value || '';
        const contact = (document.getElementById('user-contact') as HTMLInputElement)?.value || '';
        const budget = (document.getElementById('user-budget') as HTMLSelectElement)?.value || '';
        const timeline = (document.getElementById('user-timeline') as HTMLSelectElement)?.value || '';
        const details = (document.getElementById('user-details') as HTMLTextAreaElement)?.value || '';

        const text = `Hi Yasir, I would like to request a quote:\n\n- Name: ${name}\n- Service: ${selectedService}\n- Contact: ${contact}\n- Budget: ${budget}\n- Timeline: ${timeline}\n- Notes: ${details}`;
        const encodedText = encodeURIComponent(text);
        window.open(`https://wa.me/971552600494?text=${encodedText}`, '_blank');
      });
    }
  </script>
</Layout>
