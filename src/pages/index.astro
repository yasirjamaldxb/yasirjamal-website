<Layout 
  title="Web Design Dubai | Freelance Web Designer & Developer in Dubai UAE"
  description="#1 Rated Web Design Dubai & Custom Web Developer in Dubai with 15+ years experience. Custom web development, eCommerce engineering, and Google Maps local SEO across the UAE."
>
  <!-- 1. HERO BANNER SECTION -->

  <main class="flex-grow flex flex-col items-center bg-slate-50 w-full font-elegant">
    
    <!-- 1. 100% INTERACTIVE FLUID KINETIC CANVAS HERO SECTION -->
    <section class="w-full min-h-screen relative flex flex-col justify-between overflow-hidden bg-[#03050d] text-white pt-28 sm:pt-36 pb-12 sm:pb-16 select-none cursor-crosshair">
      
      <!-- Interactive Fluid Wave & Particle Canvas -->
      <canvas id="interactive-hero-canvas" class="absolute inset-0 z-0 w-full h-full"></canvas>
      
      <!-- Ambient Radial Color Glows -->
      <div class="absolute top-1/4 left-1/3 w-[500px] sm:w-[700px] h-[500px] sm:h-[700px] bg-[#1559E7]/15 rounded-full blur-[140px] pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-1/4 right-1/4 w-[400px] sm:w-[600px] h-[400px] sm:h-[600px] bg-[#6366F1]/15 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute top-1/2 right-10 w-80 h-80 bg-[#06B6D4]/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <!-- Precision Background Grid Lines -->
      <div class="absolute inset-0 z-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>

      <!-- Main Content Container -->
      <div class="w-full max-w-7xl mx-auto px-6 z-10 my-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center pointer-events-none">
        
        <!-- Left: Master Headline, Subtitle & Interactive Controls -->
        <div class="lg:col-span-8 text-left space-y-6 sm:space-y-8">
          
          <!-- Live Status & Specialty Pill -->
