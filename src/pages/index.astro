    <!-- Interactive Mouse Ambient Glow & Seamless Infinite Auto-Scroll Engine Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const portfolioSection = document.getElementById('portfolio');
        const glowBg = document.getElementById('portfolio-interactive-glow');
        const carousel = document.getElementById('portfolio-carousel');
        const cards = document.querySelectorAll('.portfolio-card');
        const prevBtn = document.getElementById('portfolio-prev');
        const nextBtn = document.getElementById('portfolio-next');

        // Permanent Modern Mesh Gradient with Smooth Interactive Mouse Tracking
        if (portfolioSection && glowBg) {
          const rect = portfolioSection.getBoundingClientRect();
          let mouseX = rect.width / 2;
          let mouseY = rect.height / 2;
          let currentX = rect.width / 2;
          let currentY = rect.height / 2;
          let hasMovedMouse = false;

          portfolioSection.addEventListener('mousemove', (e) => {
            const currentRect = portfolioSection.getBoundingClientRect();
            mouseX = e.clientX - currentRect.left;
            mouseY = e.clientY - currentRect.top;
            hasMovedMouse = true;
          });

          function animateGradient() {
            if (!hasMovedMouse) {
              const time = Date.now() * 0.0015;
              const currentRect = portfolioSection.getBoundingClientRect();
              mouseX = (currentRect.width / 2) + Math.sin(time) * 120;
              mouseY = (currentRect.height / 2) + Math.cos(time * 0.8) * 80;
            }

            currentX += (mouseX - currentX) * 0.06;
            currentY += (mouseY - currentY) * 0.06;

            if (glowBg) {
              glowBg.style.background = `radial-gradient(800px circle at ${currentX}px ${currentY}px, rgba(217, 226, 236, 0.75) 0%, rgba(241, 245, 249, 0.38) 45%, rgba(255, 255, 255, 0) 80%)`;
            }

            requestAnimationFrame(animateGradient);
          }

          animateGradient();
        }

        if (!carousel || cards.length === 0) return;

        // Pixel-Perfect Seamless Infinite Auto-Scroll Engine
        let isUserInteracting = false;
        let autoScrollSpeed = 0.85; // smooth continuous movement speed
        let autoScrollAnimationId = null;

        function getSet1Width() {
          const clones = carousel.querySelectorAll('.portfolio-card[aria-hidden="true"]');
          const firstCard = cards[0];
          if (clones.length > 0 && firstCard) {
            return clones[0].offsetLeft - firstCard.offsetLeft;
          }
          return (carousel.scrollWidth / 2);
        }

        function autoScrollLoop() {
          if (!isUserInteracting && carousel) {
            carousel.scrollLeft += autoScrollSpeed;

            const set1Width = getSet1Width();
            if (carousel.scrollLeft >= set1Width) {
              carousel.scrollLeft -= set1Width; // Seamless pixel-perfect reset with zero jump!
            }
          }
          autoScrollAnimationId = requestAnimationFrame(autoScrollLoop);
        }

        // Start auto-scroll engine
        autoScrollAnimationId = requestAnimationFrame(autoScrollLoop);

        // Pause on mouse hover / touch start so user can inspect any card smoothly
        carousel.addEventListener('mouseenter', () => { isUserInteracting = true; });
        carousel.addEventListener('mouseleave', () => { isUserInteracting = false; });
        carousel.addEventListener('touchstart', () => { isUserInteracting = true; }, { passive: true });
        carousel.addEventListener('touchend', () => {
          setTimeout(() => { isUserInteracting = false; }, 2000);
        }, { passive: true });

        // Arrow Navigation Controls
        const getScrollStep = () => {
          const firstCard = cards[0];
          return firstCard ? firstCard.offsetWidth + 28 : 500;
        };

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            isUserInteracting = true;
            carousel.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
            setTimeout(() => { isUserInteracting = false; }, 3500);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            isUserInteracting = true;
            carousel.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
            setTimeout(() => { isUserInteracting = false; }, 3500);
          });
        }
      });
    </script>



