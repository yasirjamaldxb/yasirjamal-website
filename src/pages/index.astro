    <!-- Exclusive Single-Open Animated Accordion Script -->
    <script>
      function initFaqAccordion() {
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach((item) => {
          const btn = item.querySelector('.faq-btn');
          const content = item.querySelector('.faq-content') as HTMLElement;
          const icon = item.querySelector('.faq-icon');

          if (!btn || !content) return;

          btn.addEventListener('click', () => {
            const isOpen = btn.getAttribute('aria-expanded') === 'true';

            // Close all other open items in an animated way
            faqItems.forEach((otherItem) => {
              const otherBtn = otherItem.querySelector('.faq-btn');
              const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
              const otherIcon = otherItem.querySelector('.faq-icon');

              if (otherBtn && otherContent && otherBtn !== btn) {
                otherBtn.setAttribute('aria-expanded', 'false');
                otherContent.style.maxHeight = '0px';
                if (otherIcon) otherIcon.textContent = '+';
              }
            });

            // Toggle clicked item with smooth animated scroll height
            if (isOpen) {
              btn.setAttribute('aria-expanded', 'false');
              content.style.maxHeight = '0px';
              if (icon) icon.textContent = '+';
            } else {
              btn.setAttribute('aria-expanded', 'true');
              content.style.maxHeight = content.scrollHeight + 30 + 'px';
              if (icon) icon.textContent = '−';
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFaqAccordion);
      } else {
        initFaqAccordion();
      }
    </script>
  </main>
</Layout>
