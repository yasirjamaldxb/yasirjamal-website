    <!-- Interactive Fluid Kinetic Physics Canvas Animation Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('interactive-hero-canvas');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        let width, height, animationFrameId;

        const resize = () => {
          const dpr = window.devicePixelRatio || 1;
          width = canvas.parentElement.clientWidth;
          height = canvas.parentElement.clientHeight;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          ctx.scale(dpr, dpr);
        };

        window.addEventListener('resize', resize);
        resize();

        // Interactive Mouse State
        const mouse = {
          x: width * 0.6,
          y: height * 0.5,
          targetX: width * 0.6,
          targetY: height * 0.5,
          speed: 0,
          radius: 220
        };

        const ripples = [];
        const particles = [];

        // Spawn ambient particles
        for (let i = 0; i < 45; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            radius: Math.random() * 2 + 1,
            alpha: Math.random() * 0.6 + 0.2,
            color: i % 3 === 0 ? '#38bdf8' : i % 3 === 1 ? '#818cf8' : '#60a5fa'
          });
        }

        canvas.parentElement.addEventListener('mousemove', (e) => {
          const rect = canvas.getBoundingClientRect();
          mouse.targetX = e.clientX - rect.left;
          mouse.targetY = e.clientY - rect.top;
        });

        canvas.parentElement.addEventListener('click', (e) => {
          const rect = canvas.getBoundingClientRect();
          const clickX = e.clientX - rect.left;
          const clickY = e.clientY - rect.top;
          
          ripples.push({
            x: clickX,
            y: clickY,
            radius: 5,
            maxRadius: 350,
            alpha: 0.85
          });

          // Spawn burst particles on click
          for (let p = 0; p < 12; p++) {
            const angle = Math.random() * Math.PI * 2;
            const spd = Math.random() * 4 + 2;
            particles.push({
              x: clickX,
              y: clickY,
              vx: Math.cos(angle) * spd,
              vy: Math.sin(angle) * spd,
              radius: Math.random() * 2.5 + 1,
              alpha: 1,
              color: '#38bdf8'
            });
          }
        });

        let time = 0;

        function animate() {
          ctx.clearRect(0, 0, width, height);
          time += 0.012;

          // Smooth mouse interpolation
          mouse.x += (mouse.targetX - mouse.x) * 0.08;
          mouse.y += (mouse.targetY - mouse.y) * 0.08;

          // 1. Draw Kinetic Fluid Wave Ribbons (Multi-layered 3D Bezier Waves)
          const waves = [
            { color: 'rgba(21, 89, 231, 0.25)', speed: 0.008, amplitude: 65, freq: 0.0025, y: height * 0.45 },
            { color: 'rgba(99, 102, 241, 0.22)', speed: 0.012, amplitude: 80, freq: 0.003, y: height * 0.55 },
            { color: 'rgba(6, 182, 212, 0.18)', speed: 0.01, amplitude: 50, freq: 0.002, y: height * 0.65 },
            { color: 'rgba(168, 85, 247, 0.15)', speed: 0.015, amplitude: 90, freq: 0.0035, y: height * 0.35 }
          ];

          waves.forEach((w, idx) => {
            ctx.beginPath();
            ctx.moveTo(0, height);
            
            for (let x = 0; x <= width; x += 15) {
              // Base sine harmonic
              let waveY = w.y + Math.sin(x * w.freq + time * (idx + 1) * 0.6) * w.amplitude;
              waveY += Math.cos(x * 0.0015 - time * 0.5) * 30;

              // Mouse interactive displacement
              const dx = x - mouse.x;
              const dy = waveY - mouse.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < mouse.radius) {
                const force = (mouse.radius - dist) / mouse.radius;
                waveY += Math.sin(force * Math.PI) * 45;
              }

              // Ripple shockwave displacement
              ripples.forEach(r => {
                const rDist = Math.hypot(x - r.x, waveY - r.y);
                if (Math.abs(rDist - r.radius) < 40) {
                  waveY += Math.sin((rDist - r.radius) * 0.1) * 20 * (r.alpha);
                }
              });

              if (x === 0) {
                ctx.moveTo(x, waveY);
              } else {
                ctx.lineTo(x, waveY);
              }
            }

            ctx.lineTo(width, height);
            ctx.lineTo(0, height);
            ctx.closePath();

            const gradient = ctx.createLinearGradient(0, w.y - 100, width, w.y + 150);
            gradient.addColorStop(0, w.color);
            gradient.addColorStop(1, 'rgba(3, 5, 13, 0)');
            ctx.fillStyle = gradient;
            ctx.fill();

            // Glow Top Stroke for the ribbon edge
            ctx.lineWidth = 1.2;
            ctx.strokeStyle = w.color.replace(/0\.\d+\)$/, '0.65)');
            ctx.stroke();
          });

          // 2. Render & Expand Ripples
          for (let r = ripples.length - 1; r >= 0; r--) {
            const rip = ripples[r];
            rip.radius += 4;
            rip.alpha *= 0.96;

            ctx.beginPath();
            ctx.arc(rip.x, rip.y, rip.radius, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(56, 189, 248, ${rip.alpha * 0.6})`;
            ctx.lineWidth = 1.5;
            ctx.stroke();

            if (rip.alpha < 0.02 || rip.radius > rip.maxRadius) {
              ripples.splice(r, 1);
            }
          }

          // 3. Render Floating Interactive Particles
          for (let p = particles.length - 1; p >= 0; p--) {
            const pt = particles[p];
            pt.x += pt.vx;
            pt.y += pt.vy;

            // Wrap or fade
            if (pt.x < 0) pt.x = width;
            if (pt.x > width) pt.x = 0;
            if (pt.y < 0) pt.y = height;
            if (pt.y > height) pt.y = 0;

            // Mouse proximity attraction/repulsion
            const pdx = mouse.x - pt.x;
            const pdy = mouse.y - pt.y;
            const pDist = Math.hypot(pdx, pdy);
            if (pDist < 160) {
              const pForce = (160 - pDist) / 160;
              pt.x -= (pdx / pDist) * pForce * 2;
              pt.y -= (pdy / pDist) * pForce * 2;
            }

            ctx.beginPath();
            ctx.arc(pt.x, pt.y, pt.radius, 0, Math.PI * 2);
            ctx.fillStyle = pt.color;
            ctx.globalAlpha = pt.alpha;
            ctx.fill();
            ctx.globalAlpha = 1.0;
          }

          // Limit particles array size
          if (particles.length > 80) {
            particles.splice(0, particles.length - 80);
          }

          animationFrameId = requestAnimationFrame(animate);
        }

        animate();

        window.addEventListener('beforeunload', () => {
          cancelAnimationFrame(animationFrameId);
        });
      });
    </script>


