		<link rel="apple-touch-icon" href="/images/logo.webp" />
		<meta name="generator" content={Astro.generator} />

		<!-- Eye-Catching Animated Jump & Pulse Favicon Script -->
		<script is:inline>
			(function() {
				if (typeof window === 'undefined') return;
				
				const img = new Image();
				img.crossOrigin = 'anonymous';
				img.src = '/images/logo.webp';
				
				img.onload = function() {
					const canvas = document.createElement('canvas');
					canvas.width = 32;
					canvas.height = 32;
					const ctx = canvas.getContext('2d');
					
					const favicon = document.getElementById('favicon-link') || document.querySelector("link[rel*='icon']");
					if (!favicon) return;

					let frame = 0;
					const offsets = [0, -3, -5, -3, 0, 1, 0];
					const scales = [1.0, 1.05, 1.1, 1.05, 1.0, 0.95, 1.0];

					setInterval(() => {
						ctx.clearRect(0, 0, 32, 32);
						
						const offset = offsets[frame % offsets.length];
						const scale = scales[frame % scales.length];

						// 1. Glowing outer pulse ring (alternating green & yellow)
						ctx.save();
						ctx.beginPath();
						ctx.arc(16, 16 + offset, 14.5 * scale, 0, Math.PI * 2);
						ctx.fillStyle = (frame % 2 === 0) ? '#25D366' : '#F6CD0B';
						ctx.fill();
						ctx.restore();

						// 2. Circular logo photo image
						ctx.save();
						ctx.beginPath();
						ctx.arc(16, 16 + offset, 12.5 * scale, 0, Math.PI * 2);
						ctx.clip();
						const size = 25 * scale;
						const x = 16 - size / 2;
						const y = (16 + offset) - size / 2;
						ctx.drawImage(img, x, y, size, size);
						ctx.restore();

						// 3. Eye-catching pulsing red notification dot
						if (frame % 4 < 2) {
							ctx.beginPath();
							ctx.arc(25, 7, 4.5, 0, Math.PI * 2);
							ctx.fillStyle = '#FF3B30';
							ctx.fill();
							ctx.strokeStyle = '#FFFFFF';
							ctx.lineWidth = 1.5;
							ctx.stroke();
						}

						favicon.href = canvas.toDataURL('image/png');
						frame++;
					}, 280);
				};
			})();
		</script>
    
