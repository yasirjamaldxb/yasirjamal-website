    <!-- Comprehensive Real-Time Google Analytics 4 & Conversion Intelligence -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CS5207YPC5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CS5207YPC5', {
        send_page_view: true,
        cookie_flags: 'SameSite=None;Secure'
      });
      gtag('config', 'AW-599518397');

      // 🎯 Automated Granular Attribution & Conversion Tracking
      document.addEventListener('DOMContentLoaded', function() {
        // 1. AI Search Engine & Referrer Intelligence Detector
        try {
          var ref = document.referrer.toLowerCase();
          var aiEngine = '';
          if (ref.includes('chatgpt.com') || ref.includes('openai.com')) aiEngine = 'ChatGPT Search';
          else if (ref.includes('perplexity.ai')) aiEngine = 'Perplexity AI';
          else if (ref.includes('claude.ai') || ref.includes('anthropic.com')) aiEngine = 'Claude AI';
          else if (ref.includes('gemini.google.com')) aiEngine = 'Google Gemini';
          else if (ref.includes('copilot.microsoft.com') || ref.includes('bing.com/chat')) aiEngine = 'Microsoft Copilot';

          if (aiEngine) {
            gtag('event', 'ai_search_referrer_visit', {
              ai_platform: aiEngine,
              referrer_url: document.referrer,
              landing_page: window.location.pathname
            });
          }
        } catch(e) {}

        // 2. Global Outbound, WhatsApp & Affiliate Click Listener
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.href || '';
          
          // WhatsApp Inquiries & Conversion Tracking
          if (href.includes('wa.me') || href.includes('whatsapp.com')) {
            gtag('event', 'whatsapp_lead_click', {
              event_category: 'Lead Conversion',
              event_label: link.innerText.trim() || 'WhatsApp CTA',
              page_location: window.location.pathname,
              destination: href
            });
          }

          // GoHighLevel Affiliate Clicks
          else if (href.includes('gohighlevel.com')) {
            gtag('event', 'affiliate_click', {
              affiliate_partner: 'GoHighLevel',
              event_category: 'Affiliate Commission',
              event_label: link.innerText.trim() || 'GHL CTA',
              page_location: window.location.pathname,
              target_url: href
            });
          }

          // TMDHosting Affiliate Clicks
          else if (href.includes('tmdhosting.com')) {
            gtag('event', 'affiliate_click', {
              affiliate_partner: 'TMDHosting',
              event_category: 'Affiliate Commission',
              event_label: link.innerText.trim() || 'TMD CTA',
              page_location: window.location.pathname,
              target_url: href
            });
          }

          // Live Client Case Study Outbound Visits
          else if (link.target === '_blank' && !href.includes('yasirjamal.com')) {
            gtag('event', 'outbound_portfolio_click', {
              event_category: 'Portfolio Verification',
              target_domain: link.hostname,
              page_location: window.location.pathname
            });
          }
        }, { passive: true });
      });
    </script>

