---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "#1 Rated Web Design Dubai & Custom Web Developer in Dubai with 15+ years experience. Custom web development, eCommerce engineering, and Google Maps local SEO across the UAE." 
} = Astro.props;

const rawPath = Astro.url.pathname;
const normalizedPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonicalUrl = `https://yasirjamal.com${normalizedPath}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="Expires" content="0" />
		<!-- Multi-Size Google Search & High-DPI Favicon Specification -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Agentic Browsing & WebMCP Machine-Actionable Tool Integration -->
		<link rel="alternate" type="text/plain" href="https://yasirjamal.com/llms.txt" title="LLMs Discovery" />
		<link rel="llms-txt" href="https://yasirjamal.com/llms.txt" />
		<link rel="webmcp" type="application/json" href="https://yasirjamal.com/webmcp.json" title="WebMCP Actions Declaration" />
    
    <!-- Comprehensive Real-Time Google Analytics 4 & Conversion Intelligence -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CS5207YPC5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CS5207YPC5', {
        send_page_view: true,
        cookie_flags: 'SameSite=None;Secure'
      });
      gtag('config', 'AW-599518397');

      // 🎯 Universal Multi-Touch Attribution Engine (AI Search, Social Media, Organic & Campaigns)
      document.addEventListener('DOMContentLoaded', function() {
        var originSource = 'Direct / Organic';
        var originType = 'direct';
        var ref = (document.referrer || '').toLowerCase();
        var urlParams = new URLSearchParams(window.location.search);
        var utmSource = urlParams.get('utm_source') || '';
        var utmMedium = urlParams.get('utm_medium') || '';
        var utmCampaign = urlParams.get('utm_campaign') || '';

        // 1. AI Search Engine & LLM Referrer Detector (ChatGPT, Perplexity, Claude, DeepSeek, Gemini, Copilot, Grok, Meta AI)
        if (ref.includes('chatgpt.com') || ref.includes('openai.com') || utmSource.includes('chatgpt') || utmSource.includes('openai')) {
          originSource = 'ChatGPT Search'; originType = 'ai_search';
        } else if (ref.includes('perplexity.ai') || utmSource.includes('perplexity')) {
          originSource = 'Perplexity AI'; originType = 'ai_search';
        } else if (ref.includes('claude.ai') || ref.includes('anthropic.com') || utmSource.includes('claude')) {
          originSource = 'Claude AI'; originType = 'ai_search';
        } else if (ref.includes('deepseek.com') || utmSource.includes('deepseek')) {
          originSource = 'DeepSeek AI'; originType = 'ai_search';
        } else if (ref.includes('gemini.google.com') || ref.includes('bard.google.com') || utmSource.includes('gemini')) {
          originSource = 'Google Gemini'; originType = 'ai_search';
        } else if (ref.includes('copilot.microsoft.com') || ref.includes('bing.com/chat') || utmSource.includes('copilot')) {
          originSource = 'Microsoft Copilot'; originType = 'ai_search';
        } else if (ref.includes('grok.com') || ref.includes('x.com/i/grok') || utmSource.includes('grok')) {
          originSource = 'Grok AI (xAI)'; originType = 'ai_search';
        } else if (ref.includes('meta.ai') || utmSource.includes('meta_ai')) {
          originSource = 'Meta AI'; originType = 'ai_search';
        } else if (ref.includes('poe.com') || ref.includes('mistral.ai')) {
          originSource = 'Other AI Search'; originType = 'ai_search';
        }

        // 2. Social Media Platform Detector (LinkedIn, Instagram, Twitter/X, Facebook, YouTube, TikTok, Reddit)
        else if (ref.includes('linkedin.com') || ref.includes('lnkd.in') || utmSource.includes('linkedin')) {
          originSource = 'LinkedIn'; originType = 'social_media';
        } else if (ref.includes('instagram.com') || ref.includes('l.instagram.com') || utmSource.includes('instagram')) {
          originSource = 'Instagram'; originType = 'social_media';
        } else if (ref.includes('twitter.com') || ref.includes('x.com') || ref.includes('t.co') || utmSource.includes('twitter') || utmSource.includes('x')) {
          originSource = 'Twitter / X'; originType = 'social_media';
        } else if (ref.includes('facebook.com') || ref.includes('fb.me') || ref.includes('l.facebook.com') || ref.includes('m.facebook.com') || utmSource.includes('facebook')) {
          originSource = 'Facebook'; originType = 'social_media';
        } else if (ref.includes('youtube.com') || ref.includes('youtu.be') || utmSource.includes('youtube')) {
          originSource = 'YouTube'; originType = 'social_media';
        } else if (ref.includes('reddit.com') || ref.includes('redd.it') || utmSource.includes('reddit')) {
          originSource = 'Reddit'; originType = 'social_media';
        } else if (ref.includes('tiktok.com') || utmSource.includes('tiktok')) {
          originSource = 'TikTok'; originType = 'social_media';
        } else if (ref.includes('threads.net') || utmSource.includes('threads')) {
          originSource = 'Threads'; originType = 'social_media';
        } else if (ref.includes('pinterest.com') || utmSource.includes('pinterest')) {
          originSource = 'Pinterest'; originType = 'social_media';
        }

        // 3. Search Engine Organic Detector (Google, Bing, Yahoo, DuckDuckGo)
        else if (ref.includes('google.') || utmSource.includes('google')) {
          originSource = 'Google Organic'; originType = 'search_engine';
        } else if (ref.includes('bing.com')) {
          originSource = 'Bing Search'; originType = 'search_engine';
        } else if (ref.includes('yahoo.com') || ref.includes('duckduckgo.com')) {
          originSource = 'Other Search Engine'; originType = 'search_engine';
        }

        // Save first touch attribution in Session Storage for multi-page persistence
        try {
          if (!sessionStorage.getItem('yj_first_source')) {
            sessionStorage.setItem('yj_first_source', originSource);
            sessionStorage.setItem('yj_first_type', originType);
            sessionStorage.setItem('yj_first_landing', window.location.pathname);
            if (utmSource) sessionStorage.setItem('yj_utm_source', utmSource);
            if (utmMedium) sessionStorage.setItem('yj_utm_medium', utmMedium);
            if (utmCampaign) sessionStorage.setItem('yj_utm_campaign', utmCampaign);
          }
        } catch(e) {}

        var sessionSource = sessionStorage.getItem('yj_first_source') || originSource;
        var sessionType = sessionStorage.getItem('yj_first_type') || originType;

        // Fire Granular Inbound Channel Attribution Event
        if (originType === 'ai_search') {
          gtag('event', 'ai_search_traffic', {
            ai_platform: originSource,
            referrer_url: document.referrer,
            landing_page: window.location.pathname,
            utm_source: utmSource,
            utm_campaign: utmCampaign
          });
        } else if (originType === 'social_media') {
          gtag('event', 'social_media_traffic', {
            social_network: originSource,
            referrer_url: document.referrer,
            landing_page: window.location.pathname,
            utm_source: utmSource,
            utm_campaign: utmCampaign
          });
        }

        // 4. Global Outbound, WhatsApp & Lead Click Listener with Multi-Touch Attribution
        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (!link) return;
          var href = link.href || '';
          
          // WhatsApp Inquiries & Conversion Tracking with Channel Attribution
          if (href.includes('wa.me') || href.includes('whatsapp.com')) {
            var pageName = document.title.split('|')[0].trim() || window.location.pathname;
            var currentPath = window.location.pathname;
            
            // Dynamically enrich WhatsApp URL with page attribution if not already customized
            if (!href.includes('text=') || href.endsWith('wa.me/971552600494') || href.endsWith('wa.me/971552600494/')) {
              var customMsg = encodeURIComponent("Hi Yasir, I'm visiting your website (" + pageName + ") and would like to discuss a project.");
              link.href = "https://wa.me/971552600494?text=" + customMsg;
            }

            gtag('event', 'whatsapp_lead_click', {
              event_category: 'Lead Conversion',
              event_label: link.innerText.trim() || 'WhatsApp CTA',
              traffic_source: sessionSource,
              traffic_type: sessionType,
              page_location: currentPath,
              page_title: pageName,
              destination: link.href
            });

            // Standard GA4 & Google Ads Conversion Event
            gtag('event', 'generate_lead', {
              event_category: 'Lead Conversion',
              event_label: 'WhatsApp: ' + (link.innerText.trim() || 'Direct Inquiry'),
              lead_channel: 'whatsapp',
              traffic_source: sessionSource,
              traffic_type: sessionType,
              value: 1,
              currency: 'AED',
              page_location: currentPath
            });
          }

          // GoHighLevel Affiliate Clicks
          else if (href.includes('gohighlevel.com')) {
            gtag('event', 'affiliate_click', {
              affiliate_partner: 'GoHighLevel',
              event_category: 'Affiliate Commission',
              event_label: link.innerText.trim() || 'GHL CTA',
              page_location: window.location.pathname,
              target_url: href
            });
          }

          // TMDHosting Affiliate Clicks
          else if (href.includes('tmdhosting.com')) {
            gtag('event', 'affiliate_click', {
              affiliate_partner: 'TMDHosting',
              event_category: 'Affiliate Commission',
              event_label: link.innerText.trim() || 'TMD CTA',
              page_location: window.location.pathname,
              target_url: href
            });
          }

          // Phone Call Clicks
          else if (href.startsWith('tel:')) {
            gtag('event', 'phone_call_click', {
              event_category: 'Direct Inbound Contact',
              event_label: href.replace('tel:', ''),
              page_location: window.location.pathname
            });

            gtag('event', 'generate_lead', {
              event_category: 'Lead Conversion',
              event_label: 'Phone Call: ' + href.replace('tel:', ''),
              lead_channel: 'phone',
              traffic_source: sessionSource,
              traffic_type: sessionType,
              value: 1,
              currency: 'AED',
              page_location: window.location.pathname
            });
          }

          // Email Inquiry Clicks
          else if (href.startsWith('mailto:')) {
            gtag('event', 'email_inquiry_click', {
              event_category: 'Direct Inbound Contact',
              event_label: href.replace('mailto:', ''),
              traffic_source: sessionSource,
              traffic_type: sessionType,
              page_location: window.location.pathname
            });

            gtag('event', 'generate_lead', {
              event_category: 'Lead Conversion',
              event_label: 'Email Inquiry: ' + href.replace('mailto:', ''),
              lead_channel: 'email',
              traffic_source: sessionSource,
              traffic_type: sessionType,
              value: 1,
              currency: 'AED',
              page_location: window.location.pathname
            });
          }

          // Internal Portfolio Case Study Navigation
          else if (href.includes('/portfolio/')) {
            var caseStudySlug = href.split('/portfolio/')[1]?.replace(/\/$/, '') || 'index';
            gtag('event', 'case_study_interaction', {
              event_category: 'Portfolio Engagement',
              case_study: caseStudySlug,
              page_location: window.location.pathname
            });
          }

          // Live Client Case Study Outbound Visits
          else if (link.target === '_blank' && !href.includes('yasirjamal.com')) {
            gtag('event', 'outbound_portfolio_click', {
              event_category: 'Portfolio Verification',
              target_domain: link.hostname,
              page_location: window.location.pathname
            });
          }
        }, { passive: true });

        // 3. Scroll Depth Milestone Funnel (25%, 50%, 75%, 90%)
        var trackedScroll = { 25: false, 50: false, 75: false, 90: false };
        window.addEventListener('scroll', function() {
          var h = document.documentElement, 
              b = document.body,
              st = 'scrollTop',
              sh = 'scrollHeight';
          var percent = Math.round((h[st]||b[st]) / ((h[sh]||b[sh]) - h.clientHeight) * 100);

          [25, 50, 75, 90].forEach(function(milestone) {
            if (percent >= milestone && !trackedScroll[milestone]) {
              trackedScroll[milestone] = true;
              gtag('event', 'scroll_milestone_' + milestone, {
                event_category: 'User Journey Scroll',
                scroll_depth: milestone + '%',
                page_location: window.location.pathname,
                page_title: document.title.split('|')[0].trim()
              });
            }
          });
        }, { passive: true });

        // 4. Time-on-Page Intent Milestones (15s, 30s, 60s, 120s)
        [15, 30, 60, 120].forEach(function(seconds) {
          setTimeout(function() {
            if (document.visibilityState !== 'hidden') {
              gtag('event', 'engaged_time_' + seconds + 's', {
                event_category: 'Reading Engagement',
                time_seconds: seconds,
                page_location: window.location.pathname
              });
            }
          }, seconds * 1000);
        });

        // 5. FAQ Accordion & Collapsible Engagement Tracker
        document.addEventListener('click', function(e) {
          var btn = e.target.closest('button, summary, [data-faq-trigger]');
          if (!btn) return;
          var text = btn.innerText.trim();
          if (text.length > 5 && text.length < 150 && (text.includes('?') || btn.closest('details, [class*="faq"], [id*="faq"]'))) {
            gtag('event', 'faq_accordion_open', {
              event_category: 'User Intent Research',
              question_text: text,
              page_location: window.location.pathname
            });
          }
        }, { passive: true });

        // 6. Desktop Exit-Intent & Drop-Off Tracker
        var exitTracked = false;
        document.addEventListener('mouseleave', function(e) {
          if (e.clientY <= 0 && !exitTracked) {
            exitTracked = true;
            var maxScroll = Object.keys(trackedScroll).filter(function(k){ return trackedScroll[k]; }).pop() || '0%';
            gtag('event', 'exit_intent_detected', {
              event_category: 'Drop-Off Intelligence',
              last_scroll_depth: maxScroll,
              traffic_source: sessionSource,
              page_location: window.location.pathname
            });
          }
        }, { passive: true });

        // 7. Global Form Submission Conversion Tracker
        document.addEventListener('submit', function(e) {
          var form = e.target;
          gtag('event', 'generate_lead', {
            event_category: 'Lead Conversion',
            event_label: form.id || form.name || 'Contact Form Submission',
            lead_channel: 'form',
            traffic_source: sessionSource,
            traffic_type: sessionType,
            value: 1,
            currency: 'AED',
            page_location: window.location.pathname
          });
        }, { passive: true });
      });
    </script>

    <!-- 🛡️ Zero-Impact B2B Visitor Intelligence & Retargeting Hub (Non-Blocking / SEO & LLM Protected) -->
    <script is:inline>
      (function() {
        // Defer execution until the browser has finished all critical rendering and network requests
        function initVisitorIntelligence() {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadTrackingHub, { timeout: 4000 });
          } else {
            setTimeout(loadTrackingHub, 2500);
          }
        }

        function loadTrackingHub() {
          // Check for bot user agents (Googlebot, Bingbot, GPTBot, ClaudeBot, PerplexityBot) and skip execution
          var ua = navigator.userAgent || '';
          if (/bot|crawler|spider|crawling|googlebot|bingbot|gptbot|claudebot|perplexitybot|bytespider/i.test(ua)) {
            return;
          }

          // 🚀 RB2B Person-Level LinkedIn Visitor Identification (Key: 9NMMZHXX5QNW)
          if (!window.reb2b) {
            window.reb2b = {loaded: true};
            var s = document.createElement("script");
            s.async = true;
            s.src = "https://ddwl4m2hdecbv.cloudfront.net/b/9NMMZHXX5QNW/9NMMZHXX5QNW.js.gz";
            document.head.appendChild(s);
          }

          // 🏢 Leadfeeder (Dealfront) Company-Level Visitor Intelligence (Account: p1e024B0EgZ8GB6d)
          if (!window.ldfdr) {
            window.ldfdr = function(){(window.ldfdr._q=window.ldfdr._q||[]).push([].slice.call(arguments));};
            var lfs = document.createElement("script");
            lfs.async = true;
            lfs.src = "https://sc.lfeeder.com/lftracker_v1_p1e024B0EgZ8GB6d.js";
            document.head.appendChild(lfs);
          }

          // Global Event Dispatcher for Third-Party Retargeting & Visitor ID Tools
          window.trackVisitorLead = function(leadData) {
            try {
              if (window.fbq) window.fbq('track', 'Lead', leadData);
              if (window.lintrk) window.lintrk('track', { conversion_id: 'lead' });
            } catch(e) {}
          };
        }

        if (document.readyState === 'complete') {
          initVisitorIntelligence();
        } else {
          window.addEventListener('load', initVisitorIntelligence);
        }
      })();
    </script>

