---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "#1 Rated Web Design Dubai & Custom Web Developer in Dubai with 15+ years experience. Custom web development, eCommerce engineering, and Google Maps local SEO across the UAE." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="Expires" content="0" />
		<link rel="icon" type="image/webp" id="favicon-link" href="/images/logo.webp" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/images/logo.webp" />
		<meta name="generator" content={Astro.generator} />

		<!-- Agentic Browsing & AI Search Engine Discovery -->
		<link rel="alternate" type="text/plain" href="https://yasirjamal.com/llms.txt" title="LLMs Discovery" />
		<link rel="llms-txt" href="https://yasirjamal.com/llms.txt" />
    
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-NPHBFFVZ');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) GA4 & Google Ads -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-CS5207YPC5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CS5207YPC5');
      gtag('config', 'AW-599518397');
    </script>

    <!-- Google Search Console (Webmaster Tools) Verification -->
    <meta name="google-site-verification" content="xEMh0yJJAu6CwedX7Drn-XYMtysePatx0EUy7QRlO8g" />

    <!-- Bing Webmaster Verification -->
    <meta name="msvalidate.01" content="AB70C867106155B5F76EEC669747856C" />
    
    <!-- Geo Meta Tags for Google Local & Maps Dominance -->
    <meta name="geo.region" content="AE-DU" />
    <meta name="geo.placename" content="Dubai Media City, Dubai, United Arab Emirates" />
    <meta name="geo.position" content="25.0934;55.1561" />
    <meta name="ICBM" content="25.0934, 55.1561" />

    <!-- Open Graph / Social Media Meta Tags for AI & Social Citation -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yasir Jamal | Senior Web Designer & Developer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://yasirjamal.com/images/hero_v3.jpg" />
    <meta property="og:url" content={`https://yasirjamal.com${Astro.url.pathname}`} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://yasirjamal.com/images/hero_v3.jpg" />

    <!-- Canonical Link -->
    <link rel="canonical" href={`https://yasirjamal.com${Astro.url.pathname}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
		<title>{title}</title>
    
    <!-- Comprehensive GEO & AISO Independent Verification Schema for Gemini, ChatGPT, Claude & Perplexity -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
