# ==============================================================================
# YASIR JAMAL - ENTERPRISE TECHNICAL SEO & CANONICAL REDIRECT ENGINE (.htaccess)
# ==============================================================================

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force Non-WWW (Canonical Host: yasirjamal.com)
RewriteCond %{HTTP_HOST} ^www\.yasirjamal\.com$ [NC]
RewriteRule ^(.*)$ https://yasirjamal.com/$1 [L,R=301]

# 3. Force Trailing Slash on Directories (Excluding Files with Extensions)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://yasirjamal.com/$1/ [L,R=301]

# ==============================================================================
# 4. LEGACY 301 PERMANENT REDIRECTS (FIXING 100% OF GSC 404s & CONSOLIDATING PAGERANK)
# ==============================================================================

# Legacy /work/ URLs -> /portfolio/
RewriteRule ^work/?$ https://yasirjamal.com/portfolio/ [L,R=301]
RewriteRule ^work/(.*)$ https://yasirjamal.com/portfolio/$1 [L,R=301]

# Legacy Contact & Quote URLs
RewriteRule ^contact-us/?$ https://yasirjamal.com/ [L,R=301]
RewriteRule ^contact/?$ https://yasirjamal.com/ [L,R=301]
RewriteRule ^quote/?$ https://yasirjamal.com/ [L,R=301]

# Legacy WordPress Blog URLs -> Modern Pillar & Guide URLs
RewriteRule ^blog/failed-websites/?$ https://yasirjamal.com/blog/conversion-rate-optimization-cro-lead-generation/ [L,R=301]
RewriteRule ^blog/ecommerce-business-dubai-uae/?$ https://yasirjamal.com/blog/sub-second-ecommerce-architecture-gcc-scaling/ [L,R=301]
RewriteRule ^blog/web-design-in-2024/?$ https://yasirjamal.com/blog/modern-web-design-trends-2026/ [L,R=301]
RewriteRule ^blog/why-hire-a-freelance-web-designer/?$ https://yasirjamal.com/blog/hiring-freelance-web-designer-vs-agency-dubai/ [L,R=301]
RewriteRule ^blog/my-design-process/?$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^blog/side-hustle/?$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^blog/how-to-have-a-successful-online-business/?$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^blog/ux-design-challenge-for-beginners/?$ https://yasirjamal.com/blog/ [L,R=301]

# Legacy WordPress Taxonomies, Feeds & Archives -> Clean Pages
RewriteRule ^blog/category/(.*)$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^category/(.*)$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^tag/(.*)$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^author/(.*)$ https://yasirjamal.com/about/ [L,R=301]
RewriteRule ^feed/?$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^blog/feed/?$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^comments/feed/?$ https://yasirjamal.com/blog/ [L,R=301]
RewriteRule ^wp-content/(.*)$ https://yasirjamal.com/ [L,R=301]
RewriteRule ^wp-includes/(.*)$ https://yasirjamal.com/ [L,R=301]
RewriteRule ^wp-admin/(.*)$ https://yasirjamal.com/ [L,R=301]

# ==============================================================================
# 5. SECURITY & PERFORMANCE HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html
